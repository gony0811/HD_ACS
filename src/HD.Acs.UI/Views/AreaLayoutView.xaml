<UserControl x:Class="HD.Acs.UI.Views.AreaLayoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation">
    <DockPanel Margin="12">
        <!-- 상단: 벽면 선택 + 시나리오 참고 -->
        <Border DockPanel.Dock="Top" Background="#ECF0F1" Padding="10,6" Margin="0,0,0,8" CornerRadius="3">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="벽면 전개도" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                <telerik:RadComboBox Width="220" Height="32" FontSize="13" VerticalContentAlignment="Center"
                                     ItemsSource="{Binding Walls}" SelectedItem="{Binding SelectedWall, Mode=TwoWay}" />
                <TextBlock Text="{Binding SelectedScenario.Name, StringFormat='시나리오: {0}', FallbackValue='시나리오: -'}"
                           VerticalAlignment="Center" Margin="20,0,0,0" Foreground="#566573" />
                <TextBlock VerticalAlignment="Center" Margin="20,0,0,0" Foreground="#566573"
                           Text="영역=녹색 박스 · 작업=주황 선분(seq) · 정차=보라 마커(채움:수동/링:디폴트)" />
            </StackPanel>
        </Border>

        <!-- 본문: 전개도 캔버스 (전체 폭/높이) -->
        <Border BorderBrush="#AEB6BF" BorderThickness="1" Background="#FBFCFC">
            <Viewbox Stretch="Uniform" Margin="10">
                <Canvas Width="600" Height="600">
                    <ItemsControl ItemsSource="{Binding AreaShapes}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Width="600" Height="600" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="{Binding Width}" Height="{Binding Height}">
                                    <Rectangle RadiusX="4" RadiusY="4" Fill="#2627AE60" Stroke="#229954" StrokeThickness="1.2" />
                                    <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="Bold" Foreground="#186A3B" Margin="3,1,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding TaskSegments}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Width="600" Height="600" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Canvas>
                                    <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" Stroke="#E67E22" StrokeThickness="2.5" />
                                    <Ellipse Canvas.Left="{Binding EndX}" Canvas.Top="{Binding EndY}" Width="8" Height="8" Fill="#CA6F1E" />
                                    <Border Canvas.Left="{Binding MidX}" Canvas.Top="{Binding MidY}" Background="#FEF9E7" BorderBrush="#B7950B" BorderThickness="1" CornerRadius="2" Padding="2,0">
                                        <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="Bold" Foreground="#7D6608" />
                                    </Border>
                                </Canvas>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding StationMarkers}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Width="600" Height="600" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Ellipse Width="12" Height="12" Stroke="#8E44AD" StrokeThickness="2">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOverride}" Value="True">
                                                    <Setter Property="Fill" Value="#8E44AD" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>
            </Viewbox>
        </Border>
    </DockPanel>
</UserControl>
