<Window x:Class="HD.Acs.UI.Views.NewProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        Title="새 프로젝트 — 선창 3D 정의" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Lbl">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="96" />
        </Style>
        <Style TargetType="TextBox" x:Key="TxtField">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="telerik:RadNumericUpDown">
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Width" Value="96" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="18">
        <TextBlock Text="① 선창 3D 정의 (팔각 단면)" FontWeight="Bold" FontSize="14" Margin="0,0,0,4" />
        <TextBlock Foreground="#7F8C8D" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="치수 입력 → 확인 시 10면 자동 생성(B/SL/PL/SM/PM/SU/PU/T/F/A) 후 프로젝트 파일을 만듭니다. 원점=바닥 중심, x=길이·y=폭(+좌현)·z=상방, 바닥 z=0(m). 각도=수평면 기준(°)." />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="Tank" Style="{StaticResource Lbl}" />
            <TextBox Width="110" Style="{StaticResource TxtField}" Text="{Binding TankId, Mode=TwoWay}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="L / w_floor" Style="{StaticResource Lbl}" />
            <telerik:RadNumericUpDown Width="100" Height="Auto" Value="{Binding LengthL, Mode=TwoWay}" Margin="0,0,6,0" />
            <telerik:RadNumericUpDown Width="100" Height="Auto" Value="{Binding WFloor, Mode=TwoWay}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="θ_low° / h_low" Style="{StaticResource Lbl}" />
            <telerik:RadNumericUpDown Width="100" Height="Auto" Value="{Binding ThetaLowDeg, Mode=TwoWay}" Margin="0,0,6,0" />
            <telerik:RadNumericUpDown Width="100" Height="Auto" Value="{Binding HLow, Mode=TwoWay}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="h_wall" Style="{StaticResource Lbl}" />
            <telerik:RadNumericUpDown Value="{Binding HWall, Mode=TwoWay}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="θ_up° / h_up" Style="{StaticResource Lbl}" />
            <telerik:RadNumericUpDown Width="100" Height="Auto" Value="{Binding ThetaUpDeg, Mode=TwoWay}" Margin="0,0,6,0" />
            <telerik:RadNumericUpDown Width="100" Height="Auto" Value="{Binding HUp, Mode=TwoWay}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="level_z" Style="{StaticResource Lbl}" ToolTip="쉼표 구분 z 목록 (예: 0, 3.2, 6.4, 9.6)" />
            <TextBox Width="200" Style="{StaticResource TxtField}" Text="{Binding LevelZText, Mode=TwoWay}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="reach_z min,max" Style="{StaticResource Lbl}"
                       ToolTip="(선택) 플랫폼 기준 코봇 도달 밴드 상대높이. 비우면 밴드=층 경계 그대로." />
            <TextBox Width="97" Style="{StaticResource TxtField}" Text="{Binding ReachZMinText, Mode=TwoWay}" Margin="0,0,6,0" />
            <TextBox Width="97" Style="{StaticResource TxtField}" Text="{Binding ReachZMaxText, Mode=TwoWay}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="원점보정 ox,oy" Style="{StaticResource Lbl}" />
            <telerik:RadNumericUpDown Width="100" Height="Auto" Value="{Binding OriginOx, Mode=TwoWay}" Margin="0,0,6,0" />
            <telerik:RadNumericUpDown Width="100" Height="Auto" Value="{Binding OriginOy, Mode=TwoWay}" />
        </StackPanel>

        <TextBlock Text="{Binding DerivedText}" TextWrapping="Wrap" Margin="0,2,0,4" Foreground="#2C3E50" FontSize="12" />
        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Margin="0,0,0,4" Foreground="#C0392B" FontSize="12" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <telerik:RadButton x:Name="OkButton" Content="확인 · 선창 생성" MinWidth="130" MinHeight="32" Margin="0,0,8,0" Click="Ok_Click" />
            <telerik:RadButton Content="취소" MinWidth="80" MinHeight="32" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
