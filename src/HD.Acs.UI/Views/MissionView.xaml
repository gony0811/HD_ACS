<UserControl x:Class="HD.Acs.UI.Views.MissionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="시나리오" VerticalAlignment="Center" Margin="0,0,8,0" />
            <telerik:RadComboBox Grid.Column="1"
                                 ItemsSource="{Binding Scenarios}"
                                 DisplayMemberPath="Name"
                                 SelectedItem="{Binding SelectedScenario, Mode=TwoWay}" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="로봇" VerticalAlignment="Center" Margin="0,0,8,0" />
            <telerik:RadComboBox Grid.Column="1"
                                 ItemsSource="{Binding RobotIds}"
                                 SelectedItem="{Binding SelectedRobotId, Mode=TwoWay}" />
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <telerik:RadButton Content="미션 시작" Command="{Binding StartRunCommand}" Margin="0,0,6,0" />
            <telerik:RadButton Content="다음 층 릴리스" Command="{Binding ReleaseNextCommand}" Margin="0,0,6,0" />
            <telerik:RadButton Content="새로고침" Command="{Binding RefreshCurrentRunCommand}" />
        </StackPanel>

        <telerik:RadGridView Grid.Row="3" ItemsSource="{Binding Missions}"
                             AutoGenerateColumns="False" IsReadOnly="True"
                             RowIndicatorVisibility="Collapsed">
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn Header="순서" DataMemberBinding="{Binding Seq}" Width="50" />
                <telerik:GridViewDataColumn Header="층(mapId)" DataMemberBinding="{Binding MapId}" Width="120" />
                <telerik:GridViewDataColumn Header="상태" DataMemberBinding="{Binding State}" Width="130" />
                <telerik:GridViewDataColumn Header="OrderId" DataMemberBinding="{Binding OrderId}" Width="*" />
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>

        <StackPanel Grid.Row="4" Margin="0,6,0,0">
            <TextBlock Text="{Binding CurrentRun.State, StringFormat='실행 상태: {0}'}" FontWeight="Bold" />
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#2C3E50" />
        </StackPanel>
    </Grid>
</UserControl>
