<UserControl x:Class="HD.Acs.UI.Views.OperationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:views="clr-namespace:HD.Acs.UI.Views"
             TextElement.Foreground="{DynamicResource AppTextBrush}">
    <!-- DataContext = ShellViewModel (상위에서 상속). 하위 뷰는 Shell 자식 VM에 바인딩. -->
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style x:Key="CardHead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
            <Setter Property="Padding" Value="12,9" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <!-- ── 좌: 로봇 카드 + (층 진행 / 수동 층 변경) ── -->
        <Grid Grid.Column="0" Margin="0,0,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="로봇 상태" Style="{StaticResource CardHead}" />
                    <Border Height="1" Background="{DynamicResource AppBorderBrush}" />
                    <views:RobotStatusView DataContext="{Binding RobotStatus}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}">
                <telerik:RadTabControl>
                    <telerik:RadTabItem Header="층 진행">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Margin="12,10,12,6"
                                       Text="{Binding Mission.ProgressSummary}" FontWeight="700" FontSize="14" />
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8,0,8,8">
                                <ItemsControl ItemsSource="{Binding Mission.FloorProgress}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,6" Padding="9,8" CornerRadius="8"
                                                    Background="{DynamicResource AppWindowBrush}"
                                                    BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" CornerRadius="7" Padding="0,4" VerticalAlignment="Center"
                                                            Background="{DynamicResource AppAccentSoftBrush}">
                                                        <TextBlock Text="{Binding Level}" FontWeight="700" FontSize="12"
                                                                   HorizontalAlignment="Center"
                                                                   Foreground="{DynamicResource AppAccentBrush}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="10,0">
                                                        <TextBlock Text="{Binding State}" FontSize="12.5" FontWeight="600" />
                                                        <ProgressBar Height="5" Margin="0,5,0,0" Minimum="0" Maximum="1"
                                                                     Value="{Binding Fraction, Mode=OneWay}"
                                                                     Background="{DynamicResource AppWindowBrush}"
                                                                     BorderThickness="0"
                                                                     Foreground="{DynamicResource AppAccentBrush}">
                                                            <ProgressBar.Style>
                                                                <Style TargetType="ProgressBar">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="done">
                                                                            <Setter Property="Foreground" Value="{DynamicResource AppGoodBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="fail">
                                                                            <Setter Property="Foreground" Value="{DynamicResource AppErrorBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="wait">
                                                                            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ProgressBar.Style>
                                                        </ProgressBar>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="10.5" FontWeight="700"
                                                               Text="{Binding Kind}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="done">
                                                                        <Setter Property="Foreground" Value="{DynamicResource AppGoodBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="run">
                                                                        <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="fail">
                                                                        <Setter Property="Foreground" Value="{DynamicResource AppErrorBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </telerik:RadTabItem>
                    <telerik:RadTabItem Header="수동 층 변경">
                        <views:ManualZoneChangeView DataContext="{Binding ManualZoneChange}" />
                    </telerik:RadTabItem>
                </telerik:RadTabControl>
            </Border>
        </Grid>

        <!-- ── 중앙: 공간 히어로(3D/전개도) + 미션 컨트롤 바 ── -->
        <Grid Grid.Column="1" Margin="0,0,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="1">
                <views:TankView DataContext="{Binding Tank}" />
            </Border>
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,8,0,0" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <telerik:RadComboBox Grid.Column="0" Width="180" MinHeight="30" Margin="0,0,6,0"
                                         ItemsSource="{Binding Mission.Scenarios}" DisplayMemberPath="Name"
                                         SelectedItem="{Binding Mission.SelectedScenario, Mode=TwoWay}" />
                    <telerik:RadComboBox Grid.Column="1" Width="120" MinHeight="30" Margin="0,0,10,0"
                                         ItemsSource="{Binding Mission.RobotIds}"
                                         SelectedItem="{Binding Mission.SelectedRobotId, Mode=TwoWay}" />
                    <telerik:RadButton Grid.Column="2" Content="미션 시작" MinHeight="30" Margin="0,0,6,0"
                                       Command="{Binding Mission.StartRunCommand}" />
                    <telerik:RadButton Grid.Column="3" Content="다음 층 릴리스" MinHeight="30" Margin="0,0,6,0"
                                       Command="{Binding Mission.ReleaseNextCommand}" />
                    <telerik:RadButton Grid.Column="4" Content="새로고침" MinHeight="30"
                                       Command="{Binding Mission.RefreshCurrentRunCommand}" />
                    <TextBlock Grid.Column="5" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource AppMutedTextBrush}" FontSize="12"
                               Text="{Binding Mission.StatusMessage}" />
                </Grid>
            </Border>
        </Grid>

        <!-- ── 우: 알람·이벤트 피드 ── -->
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="알람 · 이벤트" Style="{StaticResource CardHead}" />
                <Border Grid.Row="1" Height="1" Background="{DynamicResource AppBorderBrush}" />
                <views:AlarmsView Grid.Row="2" DataContext="{Binding Alarms}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
