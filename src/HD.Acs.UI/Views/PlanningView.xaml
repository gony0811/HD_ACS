<UserControl x:Class="HD.Acs.UI.Views.PlanningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:views="clr-namespace:HD.Acs.UI.Views"
             TextElement.Foreground="{DynamicResource AppTextBrush}">
    <!-- DataContext = ShellViewModel. 계획 = 시나리오 관리 + 영역·작업 정의 + 도면→맵 캘리브레이션.
         시나리오 목록/생성/삭제는 운영 콤보와 동일한 Mission.Scenarios를 공유 → 자동 동기화. -->
    <telerik:RadTabControl Margin="8">
        <telerik:RadTabItem Header="영역 · 작업">
            <views:AreaManagementView DataContext="{Binding AreaPlanning}" />
        </telerik:RadTabItem>
        <telerik:RadTabItem Header="시나리오">
            <Grid Margin="14" MaxWidth="820" HorizontalAlignment="Left">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="검사 시나리오 관리" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />

                <!-- 생성/삭제 툴바 -->
                <Border Grid.Row="1" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="이름" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Width="240" MinHeight="30" VerticalContentAlignment="Center"
                                 Text="{Binding Mission.NewScenarioName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <telerik:RadButton Content="생성" MinHeight="30" MinWidth="80" Margin="8,0,0,0"
                                           Command="{Binding Mission.CreateScenarioCommand}" />
                        <telerik:RadButton Content="삭제" MinHeight="30" MinWidth="80" Margin="16,0,0,0"
                                           Command="{Binding Mission.DeleteScenarioCommand}" />
                        <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" FontSize="11.5"
                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                   Text="{Binding Mission.TankId, StringFormat='대상 선창: {0}'}" />
                    </StackPanel>
                </Border>

                <!-- 시나리오 목록 (운영 콤보와 동일 소스) -->
                <telerik:RadGridView Grid.Row="2" ItemsSource="{Binding Mission.Scenarios}"
                                     SelectedItem="{Binding Mission.SelectedScenario, Mode=TwoWay}"
                                     AutoGenerateColumns="False" IsReadOnly="True" RowIndicatorVisibility="Collapsed">
                    <telerik:RadGridView.Columns>
                        <telerik:GridViewDataColumn Header="이름" DataMemberBinding="{Binding Name}" Width="*" />
                        <telerik:GridViewDataColumn Header="Ver" DataMemberBinding="{Binding Version}" Width="60" />
                        <telerik:GridViewDataColumn Header="상태" DataMemberBinding="{Binding Status}" Width="110" />
                        <telerik:GridViewDataColumn Header="선창" DataMemberBinding="{Binding TankId}" Width="90" />
                    </telerik:RadGridView.Columns>
                </telerik:RadGridView>

                <TextBlock Grid.Row="3" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource AppMutedTextBrush}"
                           Text="{Binding Mission.StatusMessage}" />
            </Grid>
        </telerik:RadTabItem>
        <telerik:RadTabItem Header="캘리브레이션 (T_W_D)">
            <views:CalibrationView DataContext="{Binding Calibration}" />
        </telerik:RadTabItem>
        <telerik:RadTabItem Header="AMR 티칭 테이블">
            <views:AmrTeachingView DataContext="{Binding AmrTeaching}" />
        </telerik:RadTabItem>
    </telerik:RadTabControl>
</UserControl>
