<UserControl x:Class="HD.Acs.UI.Views.AreaManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation">
    <UserControl.Resources>
        <Style TargetType="TextBlock" x:Key="Lbl">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style TargetType="telerik:RadNumericUpDown">
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Width" Value="130" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style TargetType="telerik:RadComboBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="telerik:RadGridView">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="telerik:RadButton">
            <Setter Property="MinHeight" Value="30" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── 좌열: 시나리오 + 영역 등록/목록 ── -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
            <StackPanel>
                <TextBlock Text="시나리오" FontWeight="Bold" Margin="0,0,0,4" />
                <telerik:RadComboBox ItemsSource="{Binding Scenarios}" DisplayMemberPath="Name"
                                     SelectedItem="{Binding SelectedScenario, Mode=TwoWay}" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBox Width="220" Text="{Binding NewScenarioName, Mode=TwoWay}" />
                    <telerik:RadButton Content="시나리오 생성" Margin="6,0,0,0" Command="{Binding CreateScenarioCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <telerik:RadButton Content="미션 생성(generate)" MinWidth="150" Command="{Binding GenerateCommand}" Margin="0,0,6,0" />
                    <telerik:RadButton Content="새로고침" Command="{Binding RefreshCommand}" />
                </StackPanel>

                <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="① 벽면 등록 (레지스트리 — 코드·설명)" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Foreground="#7F8C8D" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="벽면은 코드·설명만 등록합니다(층별). 정차각(벽 바라봄)은 영역·작업 seam 기하에서 자동 산출되므로 입력하지 않습니다. wall_code는 HD_AMR 티칭 조회 키입니다." />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Lv" Style="{StaticResource Lbl}" ToolTip="검사 층(1=바닥~4). 벽면은 층별로 정의." />
                            <telerik:RadNumericUpDown Width="70" Value="{Binding WallLevel, Mode=TwoWay}" />
                            <TextBlock Text="벽면코드" Style="{StaticResource Lbl}" Margin="10,0,8,0" ToolTip="벽면 코드 [TANK_WALL_LAYOUT §2] 예: SM, PM, A" />
                            <TextBox Width="80" Text="{Binding WallCodeInput, Mode=TwoWay}" />
                            <TextBlock Text="설명" Style="{StaticResource Lbl}" Margin="10,0,8,0" />
                            <TextBox Width="120" Text="{Binding WallDescription, Mode=TwoWay}" />
                        </StackPanel>
                        <telerik:RadButton Content="벽면 등록" HorizontalAlignment="Left" MinWidth="120" Command="{Binding RegisterWallCommand}" />
                        <TextBlock Text="등록된 벽면" FontWeight="SemiBold" Margin="0,10,0,4" />
                        <telerik:RadGridView ItemsSource="{Binding WallDefs}" AutoGenerateColumns="False" IsReadOnly="True"
                                             RowIndicatorVisibility="Collapsed" MinHeight="90">
                            <telerik:RadGridView.Columns>
                                <telerik:GridViewDataColumn Header="Lv" DataMemberBinding="{Binding Level}" Width="44" />
                                <telerik:GridViewDataColumn Header="벽면" DataMemberBinding="{Binding WallCode}" Width="70" />
                                <telerik:GridViewDataColumn Header="설명" DataMemberBinding="{Binding Description}" Width="*" />
                                <telerik:GridViewColumn Header="" Width="Auto">
                                    <telerik:GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <telerik:RadButton Content="삭제" Padding="8,1"
                                                Command="{Binding DataContext.DeleteWallCommand, RelativeSource={RelativeSource AncestorType=telerik:RadGridView}}"
                                                CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </telerik:GridViewColumn.CellTemplate>
                                </telerik:GridViewColumn>
                            </telerik:RadGridView.Columns>
                        </telerik:RadGridView>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="② 영역 등록 (도면 좌표 m)" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Foreground="#7F8C8D" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="해당 층 도면 좌표(m). min=좌하단·max=우상단. 사각형 중앙이 기본 정차 위치이고 정차각은 '중앙→seam 중심' 방향으로 자동 산출되므로, seam이 중앙이 아니라 벽쪽에 오도록 영역을 그리세요(정차 지점과 seam을 모두 포함). 안 되면 station_theta 수동 지정." />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Lv" Style="{StaticResource Lbl}" ToolTip="검사 층(1=바닥~4). 벽면은 층별로 중복 가능." />
                            <telerik:RadNumericUpDown Width="90" Value="{Binding AreaLevel, Mode=TwoWay}" />
                            <TextBlock Text="벽면" Style="{StaticResource Lbl}" Margin="10,0,8,0" ToolTip="등록된 벽면에서 선택 — 법선은 이 벽면에서 상속" />
                            <telerik:RadComboBox Width="90" ItemsSource="{Binding WallDefs}" DisplayMemberPath="WallCode"
                                                 SelectedValuePath="WallCode" SelectedValue="{Binding AreaWall, Mode=TwoWay}" />
                            <TextBlock Text="이름" Style="{StaticResource Lbl}" Margin="10,0,8,0" ToolTip="동일 (층·벽면) 내 유일한 영역 이름. 예: A01" />
                            <TextBox Width="70" Text="{Binding AreaName, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                    ToolTip="영역 사각형 좌하단 모서리 (도면 좌표 m). minX &lt; maxX, minY &lt; maxY.">
                            <TextBlock Text="min(X,Y)" Style="{StaticResource Lbl}" />
                            <telerik:RadNumericUpDown Value="{Binding MinX, Mode=TwoWay}" Margin="0,0,6,0" />
                            <telerik:RadNumericUpDown Value="{Binding MinY, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10"
                                    ToolTip="영역 사각형 우상단 모서리 (도면 좌표 m). 사각형은 이 영역의 모든 seam을 포함해야 하며 중앙이 기본 정차 위치.">
                            <TextBlock Text="max(X,Y)" Style="{StaticResource Lbl}" />
                            <telerik:RadNumericUpDown Value="{Binding MaxX, Mode=TwoWay}" Margin="0,0,6,0" />
                            <telerik:RadNumericUpDown Value="{Binding MaxY, Mode=TwoWay}" />
                        </StackPanel>
                        <telerik:RadButton Content="영역 등록" HorizontalAlignment="Left" MinWidth="120" Command="{Binding RegisterAreaCommand}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="영역 목록 (선택 시 우측에서 작업 등록)" FontWeight="SemiBold" Margin="0,0,0,4" />
                <telerik:RadGridView ItemsSource="{Binding Areas}" SelectedItem="{Binding SelectedArea, Mode=TwoWay}"
                                     AutoGenerateColumns="False" IsReadOnly="True" RowIndicatorVisibility="Collapsed" MinHeight="160">
                    <telerik:RadGridView.Columns>
                        <telerik:GridViewDataColumn Header="Lv" DataMemberBinding="{Binding Level}" Width="44" />
                        <telerik:GridViewDataColumn Header="벽면" DataMemberBinding="{Binding WallCode}" Width="70" />
                        <telerik:GridViewDataColumn Header="이름" DataMemberBinding="{Binding Name}" Width="70" />
                        <telerik:GridViewDataColumn Header="작업수" DataMemberBinding="{Binding TaskCount}" Width="64" />
                        <telerik:GridViewColumn Header="" Width="Auto">
                            <telerik:GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <telerik:RadButton Content="삭제" Padding="8,1"
                                        Command="{Binding DataContext.DeleteAreaCommand, RelativeSource={RelativeSource AncestorType=telerik:RadGridView}}"
                                        CommandParameter="{Binding}" />
                                </DataTemplate>
                            </telerik:GridViewColumn.CellTemplate>
                        </telerik:GridViewColumn>
                    </telerik:RadGridView.Columns>
                </telerik:RadGridView>
            </StackPanel>
        </ScrollViewer>

        <!-- ── 우열: 검사 작업 등록/목록 ── -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="10,0,0,0">
            <StackPanel>
                <TextBlock Text="{Binding SelectedArea.Name, StringFormat='선택 영역: {0}', FallbackValue='선택 영역: (없음)'}"
                           FontWeight="Bold" Margin="0,0,0,6" />
                <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="③ 검사 작업 등록 (선택 영역, 경계 내)" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="시작(X,Y,Z)" Style="{StaticResource Lbl}" />
                            <telerik:RadNumericUpDown Width="96" Value="{Binding StartX, Mode=TwoWay}" Margin="0,0,5,0" />
                            <telerik:RadNumericUpDown Width="96" Value="{Binding StartY, Mode=TwoWay}" Margin="0,0,5,0" />
                            <telerik:RadNumericUpDown Width="96" Value="{Binding StartZ, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="끝(X,Y,Z)" Style="{StaticResource Lbl}" />
                            <telerik:RadNumericUpDown Width="96" Value="{Binding EndX, Mode=TwoWay}" Margin="0,0,5,0" />
                            <telerik:RadNumericUpDown Width="96" Value="{Binding EndY, Mode=TwoWay}" Margin="0,0,5,0" />
                            <telerik:RadNumericUpDown Width="96" Value="{Binding EndZ, Mode=TwoWay}" />
                        </StackPanel>
                        <telerik:RadButton Content="작업 등록" HorizontalAlignment="Left" MinWidth="120" Command="{Binding RegisterTaskCommand}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="선택 영역 작업 목록" FontWeight="SemiBold" Margin="0,0,0,4" />
                <telerik:RadGridView ItemsSource="{Binding AreaTasks}" AutoGenerateColumns="False"
                                     IsReadOnly="True" RowIndicatorVisibility="Collapsed" MinHeight="200" Margin="0,0,0,8">
                    <telerik:RadGridView.Columns>
                        <telerik:GridViewDataColumn Header="seq" DataMemberBinding="{Binding Seq}" Width="50" />
                        <telerik:GridViewDataColumn Header="타입" DataMemberBinding="{Binding SeamType}" Width="80" />
                        <telerik:GridViewColumn Header="" Width="Auto">
                            <telerik:GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <telerik:RadButton Content="삭제" Padding="8,1"
                                        Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=telerik:RadGridView}}"
                                        CommandParameter="{Binding}" />
                                </DataTemplate>
                            </telerik:GridViewColumn.CellTemplate>
                        </telerik:GridViewColumn>
                    </telerik:RadGridView.Columns>
                </telerik:RadGridView>

                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#2C3E50" Margin="0,4,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
