<UserControl x:Class="HD.Acs.UI.Views.CalibrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:conv="clr-namespace:HD.Acs.UI.Infrastructure">
    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid Margin="10" TextElement.Foreground="{DynamicResource AppTextBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,6">
            <TextBlock Text="도면→맵 캘리브레이션 (T_W_D) · Operator" FontWeight="Bold" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource AppMutedTextBrush}"
                       Text="로봇을 도면상 알려진 기준점으로 이동시킨 뒤, 그 점의 도면 좌표를 입력하고 '현재 위치 캡처'를 누르세요. 2~3점 캡처 후 '계산'." />
        </StackPanel>

        <!-- 층 선택 + 로봇 보고 준비 상태 -->
        <Grid Grid.Row="1" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="층" VerticalAlignment="Center" Margin="0,0,8,0" />
            <telerik:RadComboBox Grid.Column="1" ItemsSource="{Binding Floors}"
                                 DisplayMemberPath="Level"
                                 SelectedItem="{Binding SelectedFloor, Mode=TwoWay}" />
        </Grid>
        <Border Grid.Row="2" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="6" Margin="0,0,0,8">
            <TextBlock Text="{Binding ReadinessText}" TextWrapping="Wrap" Foreground="{DynamicResource AppTextBrush}" />
        </Border>

        <!-- 도면 좌표 입력 + 캡처 -->
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                <TextBlock Text="도면 X" />
                <telerik:RadNumericUpDown Value="{Binding DrawingX, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="2,0">
                <TextBlock Text="도면 Y" />
                <telerik:RadNumericUpDown Value="{Binding DrawingY, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="4,0" VerticalAlignment="Bottom">
                <TextBlock Text="단위" />
                <telerik:RadComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding Unit, Mode=TwoWay}" Width="60" />
            </StackPanel>
            <telerik:RadButton Grid.Column="3" Content="현재 위치 캡처" VerticalAlignment="Bottom"
                               Margin="6,0,0,0" Command="{Binding CapturePointCommand}" />
        </Grid>

        <!-- 대응쌍 목록 -->
        <telerik:RadGridView Grid.Row="4" ItemsSource="{Binding Points}"
                             AutoGenerateColumns="False" IsReadOnly="True" RowIndicatorVisibility="Collapsed">
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn Header="도면X" DataMemberBinding="{Binding DrawingXM, StringFormat=N3}" Width="70" />
                <telerik:GridViewDataColumn Header="도면Y" DataMemberBinding="{Binding DrawingYM, StringFormat=N3}" Width="70" />
                <telerik:GridViewDataColumn Header="맵X" DataMemberBinding="{Binding MapX, StringFormat=N3}" Width="70" />
                <telerik:GridViewDataColumn Header="맵Y" DataMemberBinding="{Binding MapY, StringFormat=N3}" Width="70" />
                <telerik:GridViewColumn Header="" Width="Auto">
                    <telerik:GridViewColumn.CellTemplate>
                        <DataTemplate>
                            <telerik:RadButton Content="삭제" Padding="6,1"
                                Command="{Binding DataContext.DeletePointCommand, RelativeSource={RelativeSource AncestorType=telerik:RadGridView}}"
                                CommandParameter="{Binding}" />
                        </DataTemplate>
                    </telerik:GridViewColumn.CellTemplate>
                </telerik:GridViewColumn>
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>

        <!-- 결과 + 경고 배지 -->
        <StackPanel Grid.Row="5" Margin="0,6,0,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <telerik:RadButton Content="계산 (solve)" Command="{Binding SolveCommand}" Margin="0,0,6,0" />
                <telerik:RadButton Content="새로고침" Command="{Binding RefreshCommand}" />
            </StackPanel>
            <Border Background="{DynamicResource AppInfoBgBrush}" BorderBrush="{DynamicResource AppInfoBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="6">
                <TextBlock Text="{Binding CalibrationSummary}" TextWrapping="Wrap" Foreground="{DynamicResource AppInfoFgBrush}" />
            </Border>
            <Border Background="{DynamicResource AppWarnBgBrush}" BorderBrush="{DynamicResource AppWarnBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="6"
                    Margin="0,6,0,0" Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding WarningText}" TextWrapping="Wrap" Foreground="{DynamicResource AppWarnFgBrush}" />
            </Border>
        </StackPanel>

        <TextBlock Grid.Row="6" Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{DynamicResource AppMutedTextBrush}" Margin="0,8,0,0" />
    </Grid>
</UserControl>
