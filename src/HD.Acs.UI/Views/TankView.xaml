<UserControl x:Class="HD.Acs.UI.Views.TankView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:helix="http://helix-toolkit.org/wpf"
             xmlns:conv="clr-namespace:HD.Acs.UI.Infrastructure">
    <UserControl.Resources>
        <conv:NormalizedToCanvasConverter x:Key="NormToCanvas" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <DockPanel TextElement.Foreground="{DynamicResource AppTextBrush}">
        <!-- 층 선택 L1~L4 + 로봇 위치 -->
        <Border DockPanel.Dock="Top" Padding="8" Background="{DynamicResource AppHeaderBrush}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="뷰" VerticalAlignment="Center" Margin="0,0,8,0" />
                <telerik:RadComboBox Width="90" ItemsSource="{Binding ViewModes}"
                                     SelectedItem="{Binding SelectedViewMode, Mode=TwoWay}" />
                <CheckBox Content="영역·작업 표시" VerticalAlignment="Center" Margin="16,0,0,0"
                          IsChecked="{Binding ShowOverlays, Mode=TwoWay}" />
                <TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
                           Text="{Binding RobotMapId, StringFormat='로봇 층: {0}'}" />
                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center"
                           Text="{Binding RobotX, StringFormat='X: {0:F2}', FallbackValue='X: -'}" />
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                           Text="{Binding RobotY, StringFormat='Y: {0:F2}', FallbackValue='Y: -'}" />
            </StackPanel>
        </Border>

        <telerik:RadTabControl>
            <telerik:RadTabItem Header="3D 뷰">
                <helix:HelixViewport3D x:Name="Viewport" ZoomExtentsWhenLoaded="True"
                                       ShowCoordinateSystem="True" Background="#1B2631">
                    <helix:SunLight />
                    <helix:GridLinesVisual3D Width="40" Length="40" MajorDistance="5" MinorDistance="1"
                                             Thickness="0.03" Fill="#5D6D7E" />
                    <!-- 선창 셸(반투명 면) + 팔각 모서리 와이어 — 코드비하인드에서 지오메트리 10면으로 빌드 -->
                    <ModelVisual3D x:Name="ShellModel" />
                    <!-- 선택 층 도달 z-밴드 강조 — 코드비하인드에서 reachableVBand로 빌드 -->
                    <ModelVisual3D x:Name="LevelHighlight" />
                    <!-- 영역·작업(용접선) 오버레이 — 코드비하인드에서 영역/작업 (u,v)로 빌드 -->
                    <ModelVisual3D x:Name="OverlayModel" />
                    <!-- 로봇 마커 (코드비하인드에서 위치 갱신) -->
                    <helix:SphereVisual3D x:Name="RobotMarker" Center="0,0,0.4" Radius="0.4" Fill="#E74C3C" />
                </helix:HelixViewport3D>
            </telerik:RadTabItem>

            <telerik:RadTabItem Header="평면도(2D)">
                <!-- 상면 투영(도면 x-y). 층별 로봇 이동 가능 구역 = 데크 높이 팔각 단면 footprint(초록) + 전폭 엔벨로프(점선). -->
                <DockPanel Background="{DynamicResource AppWindowBrush}">
                    <Border DockPanel.Dock="Top" Padding="8" Background="{DynamicResource AppHeaderBrush}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding PlanCaption}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding PlanBowLabel}" Margin="16,0,0,0"
                                           Foreground="{DynamicResource AppMutedTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="· 우클릭 → 이동/벽/이동 불가/낙상 위험/노드/엣지" Margin="16,0,0,0"
                                           Foreground="{DynamicResource AppMutedTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding PlanGotoStatus}" Margin="0,4,0,0"
                                       Foreground="{DynamicResource AppAccentBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding PlanToolHint}" Margin="0,2,0,0"
                                       Foreground="#F1C40F" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Viewbox Stretch="Uniform" Margin="10">
                        <Canvas x:Name="PlanCanvas" Width="900" Height="520" Background="{DynamicResource AppCanvasBrush}"
                                Focusable="True"
                                PreviewMouseRightButtonDown="OnPlanRightDown"
                                PreviewMouseLeftButtonDown="OnPlanLeftDown"
                                PreviewKeyDown="OnPlanKeyDown"
                                MouseMove="OnPlanMouseMove"
                                MouseLeave="OnPlanMouseLeave">
                            <Canvas.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="여기로 이동" Click="OnPlanGotoClick" />
                                    <MenuItem Header="이 노드로 이동" Click="OnPlanGotoNodeClick" />
                                    <Separator />
                                    <MenuItem Header="벽 생성" Click="OnStartWall" />
                                    <MenuItem Header="이동 불가 지역" Click="OnStartNoGo" />
                                    <MenuItem Header="낙상 위험 지역" Click="OnStartHazard" />
                                    <Separator />
                                    <MenuItem Header="노드 생성" Click="OnStartNode" />
                                    <MenuItem Header="엣지 연결" Click="OnStartEdge" />
                                    <Separator />
                                    <MenuItem Header="취소" Click="OnCancelTool" />
                                </ContextMenu>
                            </Canvas.ContextMenu>
                            <!-- 전폭 엔벨로프(맥락) -->
                            <Polygon Points="{Binding PlanEnvelope}" Stroke="#5D6D7E" StrokeThickness="1.5"
                                     StrokeDashArray="4 3" Fill="#0FFFFFFF" />
                            <!-- 선택 층 이동 가능 구역 -->
                            <Polygon Points="{Binding PlanReach}" Stroke="#229954" StrokeThickness="2" Fill="#332ECC71" />
                            <!-- 이동 불가 구역(NOGO, 빨강 다각형) -->
                            <ItemsControl ItemsSource="{Binding PlanNoGos}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Polygon Points="{Binding Points}" Fill="#33E74C3C" Stroke="#E74C3C" StrokeThickness="1.5" StrokeDashArray="3 2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- 낙상 위험 구역(HAZARD, 주황 실선 + 굵은 테두리 — 필수 회피) -->
                            <ItemsControl ItemsSource="{Binding PlanHazards}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Polygon Points="{Binding Points}" Fill="#40E67E22" Stroke="#E67E22" StrokeThickness="3"
                                                 StrokeLineJoin="Round" ToolTip="{Binding Name}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- 벽(WALL, 굵은 선분) -->
                            <ItemsControl ItemsSource="{Binding PlanWalls}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Polyline Points="{Binding Points}" Stroke="#ECF0F1" StrokeThickness="3"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- 네비 엣지(노드 연결선, 파랑) -->
                            <ItemsControl ItemsSource="{Binding PlanEdges}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Polyline Points="{Binding Points}" Stroke="#3498DB" StrokeThickness="2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- 엣지 시작 노드 하이라이트(링) -->
                            <Ellipse Width="18" Height="18" Stroke="#F39C12" StrokeThickness="2" Fill="Transparent"
                                     Canvas.Left="{Binding EdgeStartLeft}" Canvas.Top="{Binding EdgeStartTop}"
                                     Visibility="{Binding EdgeStartVisible, Converter={StaticResource BoolToVis}}" />
                            <!-- 네비 노드(원, 하늘색) — Canvas.Left/Top은 컨테이너(ContentPresenter)에 걸어야 배치됨 -->
                            <ItemsControl ItemsSource="{Binding PlanNodes}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding LeftX}" />
                                        <Setter Property="Canvas.Top" Value="{Binding TopY}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="12" Height="12" Fill="#5DADE2" Stroke="White" StrokeThickness="1.5"
                                                 ToolTip="{Binding NodeId}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- 등록 요소 hover 하이라이트(노랑) — 목록 항목에 마우스 올리면 해당 오브젝트 강조 -->
                            <Polyline Points="{Binding HighlightPoly}" Stroke="#F1C40F" StrokeThickness="4" StrokeLineJoin="Round"
                                      Visibility="{Binding HighlightPolyVisible, Converter={StaticResource BoolToVis}}" />
                            <Ellipse Width="20" Height="20" Stroke="#F1C40F" StrokeThickness="3" Fill="#66F1C40F"
                                     Canvas.Left="{Binding HighlightNodeLeft}" Canvas.Top="{Binding HighlightNodeTop}"
                                     Visibility="{Binding HighlightNodeVisible, Converter={StaticResource BoolToVis}}" />
                            <!-- 진행 중 클릭 미리보기 -->
                            <Polyline Points="{Binding PlanDraft}" Stroke="#F1C40F" StrokeThickness="2" StrokeDashArray="2 2" />
                            <!-- 원점(바닥 중심) 마커 -->
                            <Ellipse Width="10" Height="10" Fill="#F1C40F" Stroke="#7D6608" StrokeThickness="1"
                                     Canvas.Left="{Binding PlanOriginX}" Canvas.Top="{Binding PlanOriginY}" />
                            <!-- 로봇 현재 위치(다른 층이면 흐리게) -->
                            <Ellipse Width="14" Height="14" Fill="#E74C3C" Stroke="White" StrokeThickness="2"
                                     Canvas.Left="{Binding PlanRobotX}" Canvas.Top="{Binding PlanRobotY}"
                                     Opacity="{Binding PlanRobotOpacity}"
                                     Visibility="{Binding PlanHasRobot, Converter={StaticResource BoolToVis}}" />
                            <!-- 마우스 hover 좌표 리드아웃(포인터 옆) -->
                            <Border Canvas.Left="{Binding PlanHoverLabelX}" Canvas.Top="{Binding PlanHoverLabelY}"
                                    Background="#CC1B2631" CornerRadius="3" Padding="5,2" IsHitTestVisible="False"
                                    Visibility="{Binding PlanHoverVisible, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding PlanHoverText}" FontSize="11" FontWeight="600" Foreground="White" />
                            </Border>
                        </Canvas>
                    </Viewbox>
                </DockPanel>
            </telerik:RadTabItem>

            <telerik:RadTabItem Header="전개도">
                <!-- 면별 2D 도면 그리드 — 각 면 실제 비율 형상(마구리 F/A=팔각) + 영역·작업 오버레이 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource AppWindowBrush}">
                    <ItemsControl ItemsSource="{Binding FacePlots}" Margin="8">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="6" Padding="6" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="3" Background="{DynamicResource AppSurfaceBrush}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Code}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AppTextBrush}" />
                                            <TextBlock Text="{Binding Dim}" FontSize="11" Foreground="{DynamicResource AppMutedTextBrush}" Margin="8,2,0,0" />
                                        </StackPanel>
                                        <Canvas Width="240" Height="150" Background="{DynamicResource AppCanvasBrush}">
                                            <Polygon Points="{Binding Outline}" Fill="#0F2E86C1" Stroke="#5D6D7E" StrokeThickness="1.2" />
                                            <!-- 영역(4점 폴리곤) -->
                                            <ItemsControl ItemsSource="{Binding Areas}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Canvas>
                                                            <Polygon Points="{Binding Points}" Fill="#2627AE60" Stroke="#229954" StrokeThickness="1" />
                                                            <TextBlock Canvas.Left="{Binding LabelX}" Canvas.Top="{Binding LabelY}" Text="{Binding Label}" FontSize="9" FontWeight="Bold" Foreground="#186A3B" />
                                                        </Canvas>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <!-- 작업 용접선 -->
                                            <ItemsControl ItemsSource="{Binding Tasks}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Canvas>
                                                            <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" Stroke="#E67E22" StrokeThickness="2" />
                                                            <Ellipse Canvas.Left="{Binding EndX}" Canvas.Top="{Binding EndY}" Width="6" Height="6" Fill="#CA6F1E" />
                                                        </Canvas>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Canvas>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </telerik:RadTabItem>
        </telerik:RadTabControl>
    </DockPanel>
</UserControl>
