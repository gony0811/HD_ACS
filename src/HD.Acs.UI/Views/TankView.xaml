<UserControl x:Class="HD.Acs.UI.Views.TankView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:helix="http://helix-toolkit.org/wpf"
             xmlns:conv="clr-namespace:HD.Acs.UI.Infrastructure">
    <UserControl.Resources>
        <conv:NormalizedToCanvasConverter x:Key="NormToCanvas" />
        <conv:WorkStatusToBrushConverter x:Key="WorkStatusBrush" />
        <conv:PointsConverter x:Key="Pts" />
    </UserControl.Resources>
    <DockPanel TextElement.Foreground="{DynamicResource AppTextBrush}">
        <!-- 층 선택 L1~L4 + 로봇 위치 -->
        <Border DockPanel.Dock="Top" Padding="8" Background="{DynamicResource AppHeaderBrush}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="뷰" VerticalAlignment="Center" Margin="0,0,8,0" />
                <telerik:RadComboBox Width="90" ItemsSource="{Binding ViewModes}"
                                     SelectedItem="{Binding SelectedViewMode, Mode=TwoWay}" />
                <CheckBox Content="영역·작업 표시" VerticalAlignment="Center" Margin="16,0,0,0"
                          IsChecked="{Binding ShowOverlays, Mode=TwoWay}" />
                <CheckBox Content="수동 이동(위치→방향 드래그)" VerticalAlignment="Center" Margin="16,0,0,0"
                          IsEnabled="{Binding IsolateLevel}"
                          ToolTip="바닥의 정차 위치에서 원하는 방향으로 드래그하세요. 짧게 클릭하면 방향 자유로 이동합니다."
                          IsChecked="{Binding ManualMoveMode, Mode=TwoWay}" />
                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource AppMutedTextBrush}"
                           Text="{Binding MoveStatus}" />
                <TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
                           Text="{Binding RobotMapId, StringFormat='로봇 층: {0}'}" />
                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center"
                           Text="{Binding RobotX, StringFormat='X: {0:F2}', FallbackValue='X: -'}" />
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                           Text="{Binding RobotY, StringFormat='Y: {0:F2}', FallbackValue='Y: -'}" />
            </StackPanel>
        </Border>

        <telerik:RadTabControl>
            <telerik:RadTabItem Header="3D 뷰">
                <helix:HelixViewport3D x:Name="Viewport" ZoomExtentsWhenLoaded="True"
                                       ShowCoordinateSystem="True" ShowViewCube="True"
                                       ViewCubeFrontText="우현" ViewCubeBackText="좌현"
                                       ViewCubeLeftText="선미" ViewCubeRightText="선수"
                                       ViewCubeTopText="상" ViewCubeBottomText="하"
                                       Background="#1B2631">
                    <helix:SunLight />
                    <helix:GridLinesVisual3D Width="40" Length="40" MajorDistance="5" MinorDistance="1"
                                             Thickness="0.03" Fill="#5D6D7E" />
                    <!-- 선창 셸(반투명 면) + 팔각 모서리 와이어 — 코드비하인드에서 지오메트리 10면으로 빌드 -->
                    <ModelVisual3D x:Name="ShellModel" />
                    <!-- 선택 층 도달 z-밴드 강조 — 코드비하인드에서 reachableVBand로 빌드 -->
                    <ModelVisual3D x:Name="LevelHighlight" />
                    <!-- 영역·작업(용접선) 오버레이 — 코드비하인드에서 영역/작업 (u,v)로 빌드 -->
                    <ModelVisual3D x:Name="OverlayModel" />
                    <!-- 층 바닥 그리드(수동 이동 클릭 평면) + 이동 목표 마커 — 코드비하인드 빌드 -->
                    <ModelVisual3D x:Name="FloorGrid" />
                    <ModelVisual3D x:Name="MoveMarker" />
                    <!-- 로봇 마커 (코드비하인드에서 위치 갱신) -->
                    <helix:SphereVisual3D x:Name="RobotMarker" Center="0,0,0.4" Radius="0.4" Fill="#E74C3C" />
                </helix:HelixViewport3D>
            </telerik:RadTabItem>

            <telerik:RadTabItem Header="전개도">
                <!-- 면별 2D 도면 그리드 — 각 면 실제 비율 형상(마구리 F/A=팔각) + 영역·작업 오버레이 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource AppWindowBrush}">
                    <ItemsControl ItemsSource="{Binding FacePlots}" Margin="8">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="6" Padding="6" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="3" Background="{DynamicResource AppSurfaceBrush}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Code}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AppTextBrush}" />
                                            <TextBlock Text="{Binding Dim}" FontSize="11" Foreground="{DynamicResource AppMutedTextBrush}" Margin="8,2,0,0" />
                                        </StackPanel>
                                        <Canvas Width="240" Height="150" Background="{DynamicResource AppCanvasBrush}">
                                            <Polygon Points="{Binding Outline, Converter={StaticResource Pts}}" Fill="#0F2E86C1" Stroke="#5D6D7E" StrokeThickness="1.2" />
                                            <!-- 영역(4점 폴리곤) -->
                                            <ItemsControl ItemsSource="{Binding Areas}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Canvas>
                                                            <!-- work_item 상태색: 계획=녹 / 대기=회 / 배차=파랑 / 완료=녹(진) / 스킵·실패=빨강 -->
                                                            <Polygon Points="{Binding Points, Converter={StaticResource Pts}}"
                                                                     Fill="{Binding Status, Converter={StaticResource WorkStatusBrush}, ConverterParameter=fill}"
                                                                     Stroke="{Binding Status, Converter={StaticResource WorkStatusBrush}, ConverterParameter=stroke}"
                                                                     StrokeThickness="1" />
                                                            <TextBlock Canvas.Left="{Binding LabelX}" Canvas.Top="{Binding LabelY}" Text="{Binding Label}" FontSize="9" FontWeight="Bold"
                                                                       Foreground="{Binding Status, Converter={StaticResource WorkStatusBrush}, ConverterParameter=stroke}" />
                                                        </Canvas>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <!-- 작업 용접선 -->
                                            <ItemsControl ItemsSource="{Binding Tasks}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Canvas>
                                                            <!-- 용접선 액션 상태색: 계획=주황 / 대기=회 / 진행=파랑 / 완료=녹 / 실패=빨강 -->
                                                            <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" StrokeThickness="2"
                                                                  Stroke="{Binding Status, Converter={StaticResource WorkStatusBrush}, ConverterParameter=weldStroke}" />
                                                            <Ellipse Canvas.Left="{Binding EndX}" Canvas.Top="{Binding EndY}" Width="6" Height="6"
                                                                     Fill="{Binding Status, Converter={StaticResource WorkStatusBrush}, ConverterParameter=weldStroke}" />
                                                        </Canvas>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Canvas>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </telerik:RadTabItem>
        </telerik:RadTabControl>
    </DockPanel>
</UserControl>
