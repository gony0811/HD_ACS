<UserControl x:Class="HD.Acs.UI.Views.RobotStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="로봇 선택" VerticalAlignment="Center" Margin="0,0,8,0" />
            <telerik:RadComboBox Width="180"
                                 ItemsSource="{Binding Robots}"
                                 DisplayMemberPath="Name"
                                 SelectedItem="{Binding SelectedRobot, Mode=TwoWay}" />
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="{Binding SelectedRobot.RobotId, StringFormat='ID: {0}'}" FontWeight="Bold" />
                <TextBlock Text="{Binding SelectedRobot.Manufacturer, StringFormat='제조사: {0}'}" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2">
            <TextBlock Text="배터리" Margin="0,0,0,2" />
            <telerik:RadProgressBar Minimum="0" Maximum="100" Height="18"
                                    Value="{Binding BatteryPct, FallbackValue=0}" />
            <TextBlock Text="{Binding BatteryPct, StringFormat='{}{0:F0} %', FallbackValue='- %'}"
                       HorizontalAlignment="Right" Margin="0,0,0,10" />

            <TextBlock Text="{Binding ConnectionState, StringFormat='연결: {0}'}" />
            <TextBlock Text="{Binding MapId, StringFormat='층(mapId): {0}'}" />
            <TextBlock Text="{Binding Position, StringFormat='위치: {0}'}" />
            <TextBlock Text="{Binding Driving, StringFormat='주행중: {0}'}" />
            <TextBlock Text="{Binding Errors, StringFormat='오류 수: {0}'}" Foreground="#C0392B" />
        </StackPanel>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" TextWrapping="Wrap"
                   Foreground="#C0392B" Margin="0,8,0,0" />
    </Grid>
</UserControl>
