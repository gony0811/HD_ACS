<UserControl x:Class="HD.Acs.UI.Views.AreaPlanningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation">
    <UserControl.Resources>
        <Style TargetType="TextBlock" x:Key="Lbl">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style TargetType="telerik:RadNumericUpDown">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Width" Value="88" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="410" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── 좌: 컨트롤/폼 ── -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
            <StackPanel>
                <!-- 시나리오 -->
                <TextBlock Text="시나리오" FontWeight="Bold" Margin="0,0,0,4" />
                <telerik:RadComboBox ItemsSource="{Binding Scenarios}" DisplayMemberPath="Name"
                                     SelectedItem="{Binding SelectedScenario, Mode=TwoWay}" MinWidth="160" MinHeight="28" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBox Width="190" MinHeight="28" VerticalContentAlignment="Center" Text="{Binding NewScenarioName, Mode=TwoWay}" />
                    <telerik:RadButton Content="시나리오 생성" Margin="6,0,0,0" MinHeight="28" Command="{Binding CreateScenarioCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <telerik:RadButton Content="미션 생성(generate)" MinHeight="30" MinWidth="140" Command="{Binding GenerateCommand}" Margin="0,0,6,0" />
                    <telerik:RadButton Content="새로고침" MinHeight="30" Command="{Binding RefreshCommand}" />
                </StackPanel>

                <!-- 영역 등록 -->
                <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="① 영역 등록 (도면 좌표 m)" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Lv" Style="{StaticResource Lbl}" />
                            <telerik:RadNumericUpDown Width="52" Value="{Binding AreaLevel, Mode=TwoWay}" />
                            <TextBlock Text="벽면" Style="{StaticResource Lbl}" Margin="8,0,8,0" />
                            <TextBox Width="60" MinHeight="28" VerticalContentAlignment="Center" Text="{Binding AreaWall, Mode=TwoWay}" />
                            <TextBlock Text="이름" Style="{StaticResource Lbl}" Margin="8,0,8,0" />
                            <TextBox Width="60" MinHeight="28" VerticalContentAlignment="Center" Text="{Binding AreaName, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="min(X,Y)" Style="{StaticResource Lbl}" />
                            <telerik:RadNumericUpDown Value="{Binding MinX, Mode=TwoWay}" Margin="0,0,6,0" />
                            <telerik:RadNumericUpDown Value="{Binding MinY, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="max(X,Y)" Style="{StaticResource Lbl}" />
                            <telerik:RadNumericUpDown Value="{Binding MaxX, Mode=TwoWay}" Margin="0,0,6,0" />
                            <telerik:RadNumericUpDown Value="{Binding MaxY, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="법선(X,Y)" Style="{StaticResource Lbl}" />
                            <telerik:RadNumericUpDown Value="{Binding NormalX, Mode=TwoWay}" Margin="0,0,6,0" />
                            <telerik:RadNumericUpDown Value="{Binding NormalY, Mode=TwoWay}" />
                        </StackPanel>
                        <telerik:RadButton Content="영역 등록" HorizontalAlignment="Left" MinHeight="30" MinWidth="110" Command="{Binding RegisterAreaCommand}" />
                    </StackPanel>
                </Border>

                <!-- 영역 목록 (선택→작업 등록 대상) -->
                <TextBlock Text="영역 목록 (선택 시 작업 등록)" FontWeight="SemiBold" Margin="0,0,0,4" />
                <telerik:RadGridView ItemsSource="{Binding Areas}" SelectedItem="{Binding SelectedArea, Mode=TwoWay}"
                                     AutoGenerateColumns="False" IsReadOnly="True" RowIndicatorVisibility="Collapsed" MinHeight="90" MaxHeight="150" Margin="0,0,0,8">
                    <telerik:RadGridView.Columns>
                        <telerik:GridViewDataColumn Header="Lv" DataMemberBinding="{Binding Level}" Width="40" />
                        <telerik:GridViewDataColumn Header="벽면" DataMemberBinding="{Binding WallCode}" Width="60" />
                        <telerik:GridViewDataColumn Header="이름" DataMemberBinding="{Binding Name}" Width="60" />
                        <telerik:GridViewDataColumn Header="작업수" DataMemberBinding="{Binding TaskCount}" Width="60" />
                        <telerik:GridViewColumn Header="" Width="Auto">
                            <telerik:GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <telerik:RadButton Content="삭제" Padding="8,1"
                                        Command="{Binding DataContext.DeleteAreaCommand, RelativeSource={RelativeSource AncestorType=telerik:RadGridView}}"
                                        CommandParameter="{Binding}" />
                                </DataTemplate>
                            </telerik:GridViewColumn.CellTemplate>
                        </telerik:GridViewColumn>
                    </telerik:RadGridView.Columns>
                </telerik:RadGridView>

                <!-- 검사 작업 등록 (선택 영역) -->
                <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="② 검사 작업 등록 (선택 영역, 경계 내)" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="시작(X,Y,Z)" Style="{StaticResource Lbl}" />
                            <telerik:RadNumericUpDown Width="66" Value="{Binding StartX, Mode=TwoWay}" Margin="0,0,4,0" />
                            <telerik:RadNumericUpDown Width="66" Value="{Binding StartY, Mode=TwoWay}" Margin="0,0,4,0" />
                            <telerik:RadNumericUpDown Width="66" Value="{Binding StartZ, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="끝(X,Y,Z)" Style="{StaticResource Lbl}" />
                            <telerik:RadNumericUpDown Width="66" Value="{Binding EndX, Mode=TwoWay}" Margin="0,0,4,0" />
                            <telerik:RadNumericUpDown Width="66" Value="{Binding EndY, Mode=TwoWay}" Margin="0,0,4,0" />
                            <telerik:RadNumericUpDown Width="66" Value="{Binding EndZ, Mode=TwoWay}" />
                        </StackPanel>
                        <telerik:RadButton Content="작업 등록" HorizontalAlignment="Left" MinHeight="30" MinWidth="110" Command="{Binding RegisterTaskCommand}" />
                    </StackPanel>
                </Border>

                <!-- 선택 영역 작업 목록 -->
                <telerik:RadGridView ItemsSource="{Binding AreaTasks}" AutoGenerateColumns="False"
                                     IsReadOnly="True" RowIndicatorVisibility="Collapsed" MinHeight="80" MaxHeight="140" Margin="0,0,0,8">
                    <telerik:RadGridView.Columns>
                        <telerik:GridViewDataColumn Header="seq" DataMemberBinding="{Binding Seq}" Width="44" />
                        <telerik:GridViewDataColumn Header="타입" DataMemberBinding="{Binding SeamType}" Width="70" />
                        <telerik:GridViewColumn Header="" Width="Auto">
                            <telerik:GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <telerik:RadButton Content="삭제" Padding="8,1"
                                        Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=telerik:RadGridView}}"
                                        CommandParameter="{Binding}" />
                                </DataTemplate>
                            </telerik:GridViewColumn.CellTemplate>
                        </telerik:GridViewColumn>
                    </telerik:RadGridView.Columns>
                </telerik:RadGridView>

                <!-- 벽면 전개도 선택 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="벽면 전개도" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <telerik:RadComboBox MinWidth="120" MinHeight="28" ItemsSource="{Binding Walls}" SelectedItem="{Binding SelectedWall, Mode=TwoWay}" />
                </StackPanel>

                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#2C3E50" />
            </StackPanel>
        </ScrollViewer>

        <!-- ── 우: 전개도 캔버스 ── -->
        <Border Grid.Column="1" BorderBrush="#AEB6BF" BorderThickness="1" Background="#FBFCFC">
            <Viewbox Stretch="Uniform" Margin="8">
                <Canvas Width="600" Height="600">
                    <!-- 영역 반투명 박스 -->
                    <ItemsControl ItemsSource="{Binding AreaShapes}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Width="600" Height="600" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="{Binding Width}" Height="{Binding Height}">
                                    <Rectangle RadiusX="4" RadiusY="4" Fill="#2627AE60" Stroke="#229954" StrokeThickness="1.2" />
                                    <TextBlock Text="{Binding Label}" FontSize="10" FontWeight="Bold" Foreground="#186A3B" Margin="3,1,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- 검사 작업 선분 + seq 배지 -->
                    <ItemsControl ItemsSource="{Binding TaskSegments}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Width="600" Height="600" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Canvas>
                                    <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" Stroke="#E67E22" StrokeThickness="2.5" />
                                    <Ellipse Canvas.Left="{Binding EndX}" Canvas.Top="{Binding EndY}" Width="8" Height="8" Fill="#CA6F1E" />
                                    <Border Canvas.Left="{Binding MidX}" Canvas.Top="{Binding MidY}" Background="#FEF9E7" BorderBrush="#B7950B" BorderThickness="1" CornerRadius="2" Padding="2,0">
                                        <TextBlock Text="{Binding BadgeText}" FontSize="9" FontWeight="Bold" Foreground="#7D6608" />
                                    </Border>
                                </Canvas>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- 정차점 마커 (채움=수동 오버라이드 / 링=디폴트) -->
                    <ItemsControl ItemsSource="{Binding StationMarkers}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Width="600" Height="600" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Ellipse Width="12" Height="12" Stroke="#8E44AD" StrokeThickness="2">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOverride}" Value="True">
                                                    <Setter Property="Fill" Value="#8E44AD" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>
            </Viewbox>
        </Border>
    </Grid>
</UserControl>
