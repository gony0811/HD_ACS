<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HD.Acs.UI</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.8" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <!-- 3D 화물창 뷰 (Q5 확정: HelixToolkit). 3.1.2 = net8.0-windows 정식 타깃 -->
    <PackageReference Include="HelixToolkit.Wpf" Version="3.1.2" />
    <!-- Telerik UI for WPF (Fluent 테마 포함) — 전용 피드(nuget.telerik.com)에서 복원.
         버전은 보유 라이선스에 맞춰 조정할 것. -->
    <PackageReference Include="Telerik.UI.for.Wpf.AllControls.Xaml" Version="2025.3.813" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <!-- 브랜드 로고 등 이미지 자산(와일드카드 — 파일 추가/교체가 csproj 수정 없이 반영) -->
  <ItemGroup>
    <Resource Include="Assets\**\*.png" />
  </ItemGroup>
</Project>
