<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      앱 공용 다크 테마 브러시. Telerik Fluent Dark 팔레트(App.xaml.cs)와 조화되도록
      비-Telerik 요소(패널 배경·본문 글씨·테두리·도면 캔버스·콜아웃)의 색을 한곳에서 정의한다.
      뷰의 하드코딩 리터럴은 DynamicResource로 이 키들을 참조한다.
      데이터-뷰 의미색(영역=녹, 용접선=주황, 끝점/오류=빨, 3D 오버레이)은 뷰에 그대로 두고
      여기서는 크롬/표면/캔버스/시맨틱 콜아웃만 관리한다.
    -->

    <!-- 표면/배경 -->
    <SolidColorBrush x:Key="AppWindowBrush"  Color="#1E1E1E" /><!-- 최상위 창/루트 -->
    <SolidColorBrush x:Key="AppHeaderBrush"  Color="#2D2D30" /><!-- 상단바·상태바 -->
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#252526" /><!-- 패널·카드 -->
    <SolidColorBrush x:Key="AppCanvasBrush"  Color="#1A1A1C" /><!-- 도면/전개도 캔버스(용지) -->

    <!-- 선/구분 -->
    <SolidColorBrush x:Key="AppBorderBrush"  Color="#3F3F46" />

    <!-- 글씨 -->
    <SolidColorBrush x:Key="AppTextBrush"       Color="#E6E6E6" /><!-- 본문 -->
    <SolidColorBrush x:Key="AppMutedTextBrush"  Color="#9AA0A6" /><!-- 보조/설명 -->
    <SolidColorBrush x:Key="AppOnAccentTextBrush" Color="#FFFFFF" /><!-- 어두운 헤더 위 글씨 -->

    <!-- 시맨틱 콜아웃 (다크 변형) -->
    <SolidColorBrush x:Key="AppErrorBrush"    Color="#E06C5B" />

    <SolidColorBrush x:Key="AppInfoBgBrush"     Color="#16324A" />
    <SolidColorBrush x:Key="AppInfoBorderBrush" Color="#2E6FA5" />
    <SolidColorBrush x:Key="AppInfoFgBrush"     Color="#A9CEEC" />

    <SolidColorBrush x:Key="AppWarnBgBrush"     Color="#3A3320" />
    <SolidColorBrush x:Key="AppWarnBorderBrush" Color="#B7950B" />
    <SolidColorBrush x:Key="AppWarnFgBrush"     Color="#E6C34A" />
</ResourceDictionary>
