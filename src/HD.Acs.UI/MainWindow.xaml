<Window x:Class="HD.Acs.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        xmlns:views="clr-namespace:HD.Acs.UI.Views"
        xmlns:vm="clr-namespace:HD.Acs.UI.ViewModels"
        xmlns:conv="clr-namespace:HD.Acs.UI.Infrastructure"
        Title="{Binding WindowTitle}" Width="1440" Height="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppWindowBrush}">
    <Window.Resources>
        <conv:EnumToVisibilityConverter x:Key="EnumVis" />
        <conv:EnumToBooleanConverter x:Key="EnumBool" />
        <!-- 상단 모드 탭 스타일 -->
        <Style x:Key="ModeTab" TargetType="telerik:RadToggleButton">
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="1,0" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ── 앱바: 브랜드 · 파일 메뉴 · 모드 탭 · 연결칩 · 비상정지(상시) ── -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource AppHeaderBrush}" Padding="12,7">
            <DockPanel LastChildFill="True">
                <Image DockPanel.Dock="Left" VerticalAlignment="Center" Height="26" Margin="0,0,4,0"
                       Source="/HD.Acs.UI;component/Assets/HHI_white2_ko.png"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       ToolTip="HD_ACS — HD현대중공업 LNG 화물창 검사 관제"
                       AutomationProperties.Name="HD_ACS" />
                <telerik:RadMenu DockPanel.Dock="Left" Background="Transparent" VerticalAlignment="Center" Margin="14,0,0,0">
                    <telerik:RadMenuItem Header="파일(_F)">
                        <telerik:RadMenuItem Header="새 프로젝트(_N)…" Command="{Binding NewProjectCommand}" />
                        <telerik:RadMenuItem Header="열기(_O)…" Command="{Binding OpenProjectCommand}" />
                        <telerik:RadMenuItem IsSeparator="True" />
                        <telerik:RadMenuItem Header="저장(_S)" Command="{Binding SaveProjectCommand}" />
                        <telerik:RadMenuItem Header="다른 이름으로 저장(_A)…" Command="{Binding SaveProjectAsCommand}" />
                    </telerik:RadMenuItem>
                </telerik:RadMenu>

                <!-- 우측 클러스터: 연결 상태칩 + 비상정지 -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="20" Padding="10,4" Margin="0,0,10,0"
                            Background="{DynamicResource AppWindowBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource AppGoodBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="{Binding ConnectionText}" FontSize="12" Foreground="{DynamicResource AppMutedTextBrush}" />
                        </StackPanel>
                    </Border>
                    <telerik:RadButton Content="■ 비상정지" Command="{Binding EmergencyStopCommand}"
                                       Background="#C0392B" Foreground="White" FontWeight="Bold" Padding="14,6" />
                </StackPanel>

                <!-- 중앙: 모드 탭 -->
                <Border HorizontalAlignment="Center" CornerRadius="9" Padding="3" Margin="16,0"
                        Background="{DynamicResource AppWindowBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <telerik:RadToggleButton Content="운영" Style="{StaticResource ModeTab}"
                                                 Command="{Binding SetModeCommand}" CommandParameter="{x:Static vm:AppMode.Operation}"
                                                 IsChecked="{Binding CurrentMode, Converter={StaticResource EnumBool}, ConverterParameter=Operation, Mode=OneWay}" />
                        <telerik:RadToggleButton Content="계획" Style="{StaticResource ModeTab}"
                                                 Command="{Binding SetModeCommand}" CommandParameter="{x:Static vm:AppMode.Planning}"
                                                 IsChecked="{Binding CurrentMode, Converter={StaticResource EnumBool}, ConverterParameter=Planning, Mode=OneWay}" />
                        <telerik:RadToggleButton Content="이력" Style="{StaticResource ModeTab}"
                                                 Command="{Binding SetModeCommand}" CommandParameter="{x:Static vm:AppMode.History}"
                                                 IsChecked="{Binding CurrentMode, Converter={StaticResource EnumBool}, ConverterParameter=History, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- ── 하단 상태바 ── -->
        <telerik:RadBusyIndicator DockPanel.Dock="Bottom" IsBusy="False">
            <Border Background="{DynamicResource AppHeaderBrush}" Padding="12,4">
                <TextBlock Text="{Binding ConnectionText}" Foreground="{DynamicResource AppTextBrush}" FontSize="12" />
            </Border>
        </telerik:RadBusyIndicator>

        <!-- ── 본문: 모드별 워크스페이스(모두 로드 유지, Visibility 전환) ── -->
        <Grid>
            <views:OperationView Visibility="{Binding CurrentMode, Converter={StaticResource EnumVis}, ConverterParameter=Operation}" />
            <views:PlanningView  Visibility="{Binding CurrentMode, Converter={StaticResource EnumVis}, ConverterParameter=Planning}" />
            <views:HistoryView   Visibility="{Binding CurrentMode, Converter={StaticResource EnumVis}, ConverterParameter=History}" />
        </Grid>
    </DockPanel>
</Window>
