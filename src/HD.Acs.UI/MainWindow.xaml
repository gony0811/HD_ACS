<Window x:Class="HD.Acs.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        xmlns:views="clr-namespace:HD.Acs.UI.Views"
        Title="HD_ACS — LNG 화물창 용접검사로봇 관제" Width="1440" Height="900"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- 상단 툴바: 미션 제어 + 비상정지 -->
        <Border DockPanel.Dock="Top" Background="#2C3E50" Padding="10,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="HD_ACS 관제" Foreground="White" FontSize="16" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,20,0" />
                <telerik:RadButton Content="미션 시작" Command="{Binding Mission.StartRunCommand}" Margin="0,0,6,0" />
                <telerik:RadButton Content="다음 층 릴리스" Command="{Binding Mission.ReleaseNextCommand}" Margin="0,0,6,0" />
                <telerik:RadButton Content="■ 비상정지" Command="{Binding EmergencyStopCommand}"
                                   Background="#C0392B" Foreground="White" FontWeight="Bold" Margin="20,0,0,0" />
            </StackPanel>
        </Border>

        <!-- 하단 상태바: 서버 연결 상태 -->
        <telerik:RadBusyIndicator DockPanel.Dock="Bottom" IsBusy="False">
            <Border Background="#ECF0F1" Padding="10,4">
                <TextBlock Text="{Binding ConnectionText}" />
            </Border>
        </telerik:RadBusyIndicator>

        <!-- 본문: 좌측 화물창 뷰(도큐먼트) + 우측 운영 패널(도킹) -->
        <telerik:RadDocking x:Name="Docking" HasDocumentHost="True">
            <telerik:RadDocking.DocumentHost>
                <telerik:RadSplitContainer>
                    <telerik:RadPaneGroup>
                        <telerik:RadPane Header="화물창 3D / 전개도" CanUserClose="False" CanFloat="False">
                            <views:TankView DataContext="{Binding Tank}" />
                        </telerik:RadPane>
                        <telerik:RadPane Header="슬라이싱/TASK" CanUserClose="False" CanFloat="False">
                            <views:SlicingView DataContext="{Binding Slicing}" />
                        </telerik:RadPane>
                    </telerik:RadPaneGroup>
                </telerik:RadSplitContainer>
            </telerik:RadDocking.DocumentHost>

            <telerik:RadSplitContainer InitialPosition="DockedRight" Width="400">
                <telerik:RadPaneGroup>
                    <telerik:RadPane Header="로봇 상태" CanUserClose="False">
                        <views:RobotStatusView DataContext="{Binding RobotStatus}" />
                    </telerik:RadPane>
                    <telerik:RadPane Header="미션" CanUserClose="False">
                        <views:MissionView DataContext="{Binding Mission}" />
                    </telerik:RadPane>
                </telerik:RadPaneGroup>
                <telerik:RadPaneGroup>
                    <telerik:RadPane Header="수동 층 변경" CanUserClose="False">
                        <views:ManualZoneChangeView DataContext="{Binding ManualZoneChange}" />
                    </telerik:RadPane>
                    <telerik:RadPane Header="캘리브레이션(T_W_D)" CanUserClose="False">
                        <views:CalibrationView DataContext="{Binding Calibration}" />
                    </telerik:RadPane>
                    <telerik:RadPane Header="알람" CanUserClose="False">
                        <views:AlarmsView DataContext="{Binding Alarms}" />
                    </telerik:RadPane>
                </telerik:RadPaneGroup>
            </telerik:RadSplitContainer>
        </telerik:RadDocking>
    </DockPanel>
</Window>
