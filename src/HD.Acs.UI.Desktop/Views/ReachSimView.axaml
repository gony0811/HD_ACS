<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:HD.Acs.UI.Desktop.Views"
             xmlns:infra="using:HD.Acs.UI.Desktop.Infrastructure"
             x:Class="HD.Acs.UI.Desktop.Views.ReachSimView">
    <!-- DataContext = ReachSimViewModel. 좌: 정차·용접선 선택·조정·판정·IK 해 / 우: 3D (탭을 처음 열 때 조사 시작) -->
    <UserControl.Resources>
        <infra:ReachLevelToBrushConverter x:Key="LevelBrush" />
    </UserControl.Resources>

    <Grid Margin="10" ColumnDefinitions="450,*" TextBlock.Foreground="{DynamicResource AppTextBrush}">
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
            <StackPanel Spacing="10">
                <!-- 정차·용접선 -->
                <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="10">
                    <StackPanel Spacing="5">
                        <TextBlock Text="정차 · 용접선" FontWeight="SemiBold" />
                        <TextBlock Text="ACS 정차점(배차와 같은 식)에서 FR5-WML 이 ② 접근 400 → 정렬 준비 300 → 초점 검사 세 자세로 용접선에 닿을 때 관절 위치와 탱크 면 간섭을 봅니다. 정차점 최적화의 '적용'만 영역 정차를 바꿉니다."
                                   Foreground="{DynamicResource AppMutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="층" Classes="lbl" />
                            <ComboBox Classes="field" Width="80" ItemsSource="{Binding Levels}" SelectedIndex="{Binding LevelIndex}" />
                            <TextBlock Text="면" Classes="lbl" Margin="10,0,4,0" MinWidth="0" />
                            <ComboBox Classes="field" Width="90" ItemsSource="{Binding WallCodes}" SelectedItem="{Binding SelectedWall}" />
                            <Button Content="다시 조사" Margin="8,0,0,0" Command="{Binding SurveyCommand}" />
                        </StackPanel>
                        <CheckBox Content="IK 가지: 간섭 여유 최대 (끄면 운영 규칙 = 자세 여유 최대)" IsChecked="{Binding ClearanceBranch}" FontSize="11.5" />
                        <TextBlock Text="{Binding SurveySummary}" FontSize="11.5" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="영역" Classes="lbl" />
                            <ComboBox Classes="field" Width="330" ItemsSource="{Binding Areas}" SelectedItem="{Binding SelectedArea}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="용접선" Classes="lbl" />
                            <ComboBox Classes="field" Width="330" ItemsSource="{Binding Seams}" SelectedItem="{Binding SelectedSeam}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="점" Classes="lbl" />
                            <ComboBox Classes="field" Width="90" ItemsSource="{Binding Points}" SelectedIndex="{Binding PointIndex}" />
                            <TextBlock Text="자세" Classes="lbl" Margin="10,0,4,0" MinWidth="0" />
                            <ComboBox Classes="field" Width="140" ItemsSource="{Binding Stages}" SelectedIndex="{Binding StageIndex}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" IsVisible="{Binding HasYawChoice}">
                            <TextBlock Text="차체 방향" Classes="lbl" />
                            <ComboBox Classes="field" Width="140" ItemsSource="{Binding YawOptions}" SelectedIndex="{Binding YawIndex}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 정차·리프트 조정 -->
                <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="10">
                    <StackPanel Spacing="4">
                        <TextBlock Text="정차 · 리프트 조정" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="90,*,64" RowDefinitions="Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Text="리프트 h" VerticalAlignment="Center" />
                            <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="1000" SmallChange="10" LargeChange="100"
                                    TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding StrokeMm}" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding StrokeMm, StringFormat='{}{0:0} mm'}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            <TextBlock Grid.Row="1" Text="전후 (벽 +)" VerticalAlignment="Center" />
                            <Slider Grid.Row="1" Grid.Column="1" Minimum="-1500" Maximum="600" SmallChange="10" LargeChange="100"
                                    TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding OffsetForwardMm}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding OffsetForwardMm, StringFormat='{}{0:0} mm'}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            <TextBlock Grid.Row="2" Text="좌우 (좌 +)" VerticalAlignment="Center" />
                            <Slider Grid.Row="2" Grid.Column="1" Minimum="-1500" Maximum="1500" SmallChange="10" LargeChange="100"
                                    TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding OffsetLeftMm}" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding OffsetLeftMm, StringFormat='{}{0:0} mm'}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Content="ACS 정차 · 조사 리프트로" Command="{Binding ResetStationCommand}" />
                        </StackPanel>
                        <TextBlock Text="리프트 기본값은 조사가 고른 높이(간섭 없이 닿으면 여유 최대, 아니면 간섭 최소)입니다."
                                   Foreground="{DynamicResource AppMutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 정차점 최적화 -->
                <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="10">
                    <StackPanel Spacing="5">
                        <TextBlock Text="정차점 최적화" FontWeight="SemiBold" />
                        <TextBlock Text="영역마다 정차를 벽 안쪽 거리·좌우·방향(±15°)으로 옮겨 보며 간섭 없이 닿는 용접선이 가장 많은 곳을 찾습니다. 계산만 하고, 적용하면 영역 정차 덮어쓰기(x·y·방향)로 저장되어 배차가 그 정차를 씁니다."
                                   Foreground="{DynamicResource AppMutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Content="이 층·면 최적화" Command="{Binding OptimizeStationsCommand}" />
                            <Button Content="찾은 정차 미리보기" Command="{Binding PreviewOptimumCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding OptimizeSummary}" FontSize="11.5" TextWrapping="Wrap" />
                        <DataGrid ItemsSource="{Binding Optima}" SelectedItem="{Binding SelectedOptimum}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserSortColumns="False" HeadersVisibility="Column" MaxHeight="260">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="영역" Binding="{Binding Area}" Width="112" />
                                <DataGridTextColumn Header="지금" Binding="{Binding Current}" Width="76" />
                                <DataGridTextColumn Header="찾은" Binding="{Binding Best}" Width="76" />
                                <DataGridTextColumn Header="안쪽 거리 · 보정" Binding="{Binding Move}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="{Binding OptimumDetail}" FontSize="11.5" TextWrapping="Wrap" />
                        <TextBlock Text="지금·찾은 = 간섭 없음/간섭/도달 불가 용접선 수. 안쪽 거리 = 영역 중심에서 벽 반대쪽(수평)으로 [m], 좌 = 차체 좌측 이동 [m]."
                                   Foreground="{DynamicResource AppMutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Content="고른 영역 적용" Command="{Binding ApplyOptimumCommand}" />
                            <Button Content="옮길 영역 모두 적용" Command="{Binding ApplyAllOptimaCommand}" />
                            <Button Content="선택 영역 덮어쓰기 해제" Command="{Binding ClearStationOverrideCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 판정 -->
                <Border BorderBrush="{Binding VerdictLevel, Converter={StaticResource LevelBrush}}" BorderThickness="1.5" CornerRadius="4" Padding="10">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding VerdictTitle}" FontWeight="Bold" FontSize="15"
                                   Foreground="{Binding VerdictLevel, Converter={StaticResource LevelBrush}}" />
                        <TextBlock Text="{Binding VerdictDetail}" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource AppMutedTextBrush}" />
                    </StackPanel>
                </Border>
                <DataGrid ItemsSource="{Binding Parts}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="330"
                          CanUserSortColumns="False" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="부품" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="높이(m)" Binding="{Binding HeightM}" Width="70" />
                        <DataGridTextColumn Header="면 · 상대" Binding="{Binding Plane}" Width="100" />
                        <DataGridTemplateColumn Header="여유(mm)" Width="96">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ClearanceMm}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                                               Foreground="{Binding Level, Converter={StaticResource LevelBrush}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- IK 해 -->
                <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="10">
                    <StackPanel Spacing="5">
                        <TextBlock Text="IK 해 (같은 TCP, 가지별)" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Content="운영 선택으로" Command="{Binding OperationalSolutionCommand}" />
                            <Button Content="간섭 최소 해" Command="{Binding ClearestSolutionCommand}" />
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding Solutions}" SelectedItem="{Binding SelectedSolution}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserSortColumns="False" HeadersVisibility="Column" MaxHeight="300">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Label}" Width="44" />
                                <DataGridTextColumn Header="J1~J5 °" Binding="{Binding Joints}" Width="*" />
                                <DataGridTextColumn Header="자세" Binding="{Binding Posture}" Width="52" />
                                <DataGridTextColumn Header="J5 몸체" Binding="{Binding WristBody}" Width="68" />
                                <DataGridTemplateColumn Header="여유 mm" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding MinClearanceMm}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                                                       Foreground="{Binding Level, Converter={StaticResource LevelBrush}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="★ 운영 선택: ② 는 자세 여유 최대 해, 정렬 준비·초점 검사는 앞 자세 해에 가장 가까운 해. 행을 고르면 그 해로 그립니다."
                                   Foreground="{DynamicResource AppMutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <TextBlock Text="모델: FR5-WML DH(관절 0점 UR 규약 가정) · TCP 플랜지 +375 · BASE 차체 중심 위 1635 + h · 차체 730×700×887(앞 395) · 리프트 기둥 200×200 · 신호탑(후방, 933) · 링크 캡슐 근사 · 탱크는 ACS 면 정의(평면). 팔은 탱크 면과 차체·신호탑·리프트 기둥(자기 간섭) 모두와 잽니다. 여유 50 mm 미만은 주의."
                           Foreground="{DynamicResource AppMutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
                <TextBlock Text="{Binding StatusMessage}" FontSize="11.5" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <!-- 3D -->
        <Grid Grid.Column="1">
            <views:ReachSim3DControl x:Name="View3D" />
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Button Content="단면" Click="OnPresetSection" />
                <Button Content="정면" Click="OnPresetFront" />
                <Button Content="위" Click="OnPresetTop" />
                <Button Content="3D" Click="OnPresetIso" />
                <ToggleButton Content="단면 자르기" IsChecked="{Binding ClipSection}" Margin="6,0,0,0" />
            </StackPanel>
            <Border Margin="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Padding="8,4" CornerRadius="4"
                    Background="#CC12181D">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="■ 코봇" Foreground="#2F9CA6" FontSize="11.5" />
                    <TextBlock Text="■ 여유 &lt; 50 mm" Foreground="#E3A23B" FontSize="11.5" />
                    <TextBlock Text="■ 간섭" Foreground="#EF6A5E" FontSize="11.5" />
                    <TextBlock Text="■ 대상 용접선" Foreground="#F0B400" FontSize="11.5" />
                    <TextBlock Text="좌드래그 회전 · 우드래그 이동 · 휠 확대" Foreground="#9AA0A6" FontSize="11.5" />
                </StackPanel>
            </Border>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" VerticalAlignment="Top" Height="3" Margin="0" />
        </Grid>
    </Grid>
</UserControl>
