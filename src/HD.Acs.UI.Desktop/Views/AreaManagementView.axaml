<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:HD.Acs.UI.Desktop.Views"
             xmlns:infra="using:HD.Acs.UI.Desktop.Infrastructure"
             x:Class="HD.Acs.UI.Desktop.Views.AreaManagementView">
    <!-- DataContext = AreaPlanningViewModel. ESC: 도면 4점 선택(픽) 모드 해제 (폼·전개도 캔버스 공통 서브트리) -->
    <UserControl.Resources>
        <infra:BoolToBrushConverter x:Key="ChatBg" TrueBrush="#33305A7A" FalseBrush="#1A1ABC9C" />
    </UserControl.Resources>
    <UserControl.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding CancelPickCommand}" />
    </UserControl.KeyBindings>

    <Grid Margin="14" ColumnDefinitions="Auto,*,360" TextBlock.Foreground="{DynamicResource AppTextBrush}">
        <!-- ── 좌: 등록 폼 (영역 → 작업) ── -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
            <StackPanel Width="450">
                <!-- 선창 정의는 [파일 ▸ 새 프로젝트] 팝업에서 수행 -->
                <Border Background="{DynamicResource AppInfoBgBrush}" BorderBrush="{DynamicResource AppInfoBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,0,0,10">
                    <StackPanel TextBlock.Foreground="{DynamicResource AppInfoFgBrush}">
                        <TextBlock Text="{Binding TankId, StringFormat='현재 선창: {0}'}" FontWeight="Bold" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding DerivedText}" TextWrapping="Wrap" FontSize="12" />
                        <TextBlock Text="선창 3D 정의는 [파일 ▸ 새 프로젝트] 또는 [열기]에서 수행합니다." FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- ② 영역 등록 (면 로컬 u,v) -->
                <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="② 영역 등록·수정 (면 로컬 u,v · m)" FontWeight="SemiBold" Margin="0,0,0,2" />
                        <TextBlock Text="영역 목록에서 행을 선택하면 값이 폼에 채워집니다 → 고친 뒤 [선택 영역 수정]." Foreground="{DynamicResource AppMutedTextBrush}" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="층 필터" Classes="lbl" />
                            <ComboBox Classes="field" Width="100" ItemsSource="{Binding Levels}" DisplayMemberBinding="{Binding Label}"
                                      SelectedItem="{Binding SelectedLevel}" />
                            <TextBlock Text="면" Classes="lbl" Margin="10,0,4,0" MinWidth="0" />
                            <ComboBox Classes="field" Width="100" ItemsSource="{Binding Walls}" DisplayMemberBinding="{Binding WallCode}"
                                      SelectedItem="{Binding SelectedWall}" />
                        </StackPanel>
                        <TextBlock Text="층을 고르면 그 층에서 도달 가능한 면만 표시됩니다. 층은 영역 z범위로 서버가 자동 유도합니다." Foreground="{DynamicResource AppMutedTextBrush}" FontSize="11" Margin="0,0,0,2" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectedWallInfo}" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="11" Margin="0,0,0,4" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="이름" Classes="lbl" />
                            <TextBox Width="100" Classes="field" Text="{Binding AreaName}" />
                        </StackPanel>
                        <ToggleButton Content="도면에서 4점 선택" HorizontalAlignment="Left" MinWidth="130" Margin="0,2,0,4"
                                      IsChecked="{Binding PickMode}"
                                      ToolTip.Tip="켜면 전개도 커서가 크로스헤어로 바뀌고 클릭으로 P1~P4를 지정합니다. 캔버스 우클릭 또는 ESC로 해제." />
                        <TextBlock Text="사각형 4점 (면 로컬 u,v) — 숫자 입력 또는 [도면에서 4점 선택] 후 캔버스를 순서대로 4번 클릭(우클릭=해제)" Foreground="{DynamicResource AppMutedTextBrush}" FontSize="11" Margin="0,0,0,2" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="P1 u,v" Classes="lbl" />
                            <NumericUpDown Classes="field" MinWidth="150" Value="{Binding C1U}" Margin="0,0,6,0" />
                            <NumericUpDown Classes="field" MinWidth="150" Value="{Binding C1V}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="P2 u,v" Classes="lbl" />
                            <NumericUpDown Classes="field" MinWidth="150" Value="{Binding C2U}" Margin="0,0,6,0" />
                            <NumericUpDown Classes="field" MinWidth="150" Value="{Binding C2V}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="P3 u,v" Classes="lbl" />
                            <NumericUpDown Classes="field" MinWidth="150" Value="{Binding C3U}" Margin="0,0,6,0" />
                            <NumericUpDown Classes="field" MinWidth="150" Value="{Binding C3V}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="P4 u,v" Classes="lbl" />
                            <NumericUpDown Classes="field" MinWidth="150" Value="{Binding C4U}" Margin="0,0,6,0" />
                            <NumericUpDown Classes="field" MinWidth="150" Value="{Binding C4V}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                    ToolTip.Tip="정차점 = 영역 중심에서 벽 내부향 법선(수평) 방향으로 이 거리만큼 이격. 빈값=서버 기본(0.8m). 바닥/천장(B/T) 면은 적용 불가 — 수동 지정 사용.">
                            <TextBlock Text="정차 이격[m]" Classes="lbl" />
                            <NumericUpDown Classes="field" MinWidth="150" Minimum="0" Value="{Binding StationStandoffM}" />
                        </StackPanel>
                        <CheckBox Content="정차 수동 지정 (전역 x,y,θ) — 바닥/천장(B/T) 면은 필수" IsChecked="{Binding StationOverride}" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6" IsEnabled="{Binding StationOverride}">
                            <TextBlock Text="x,y" Classes="lbl" />
                            <NumericUpDown Classes="field" MinWidth="150" Value="{Binding StationX}" Margin="0,0,6,0" />
                            <NumericUpDown Classes="field" MinWidth="150" Value="{Binding StationY}" Margin="0,0,6,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6" IsEnabled="{Binding StationOverride}">
                            <TextBlock Text="θ" Classes="lbl" />
                            <NumericUpDown Classes="field" MinWidth="150" Value="{Binding StationTheta}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Classes="form" Content="영역 등록" MinWidth="110" Command="{Binding RegisterAreaCommand}" />
                            <Button Classes="form" Content="선택 영역 수정" MinWidth="110" Margin="6,0,0,0" Command="{Binding UpdateAreaCommand}"
                                    ToolTip.Tip="영역 목록에서 고른 영역의 이름·4점·정차를 고칩니다. 삭제 후 재등록과 달리 areaId와 작업(taskId)이 유지됩니다. 면은 바꿀 수 없고, 층은 새 코너로 다시 유도됩니다." />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ③ 검사 작업 등록 (선택 영역, 경계 내) -->
                <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="10">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedArea.Name, StringFormat='③ 검사 작업 등록 — 영역 {0}', FallbackValue='③ 검사 작업 등록 (영역 선택)'}"
                                   FontWeight="SemiBold" Margin="0,0,0,2" />
                        <TextBlock Text="작업 목록에서 행을 선택하면 값이 폼에 채워집니다 → 고친 뒤 [선택 작업 수정]." Foreground="{DynamicResource AppMutedTextBrush}" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="시작 u,v" Classes="lbl" />
                            <NumericUpDown Classes="field" Value="{Binding StartU}" Margin="0,0,6,0" />
                            <NumericUpDown Classes="field" Value="{Binding StartV}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="끝 u,v" Classes="lbl" />
                            <NumericUpDown Classes="field" Value="{Binding EndU}" Margin="0,0,6,0" />
                            <NumericUpDown Classes="field" Value="{Binding EndV}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="용접라인 타입" Classes="lbl" />
                            <ComboBox Classes="field" Width="120" ItemsSource="{Binding SeamTypes}" SelectedItem="{Binding SelectedSeamType}"
                                      IsEnabled="{Binding SeamTypeEditable}" />
                        </StackPanel>
                        <!-- CROSS3/4 교차 그리기: 전개도에서 중심·가지 클릭 → 회전 자동 유도 [VDA §8.5.1] -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="교차 그리기" Classes="lbl" />
                            <Button Classes="form" Content="CROSS3" MinWidth="70" Command="{Binding StartCrossDrawCommand}" CommandParameter="CROSS3"
                                    ToolTip.Tip="T자 3갈래. 전개도에서 중심→줄기→통과2 클릭. 줄기 방향으로 회전(R0/R90/R180/R270) 자동 결정." />
                            <Button Classes="form" Content="CROSS4" MinWidth="70" Margin="6,0,0,0" Command="{Binding StartCrossDrawCommand}" CommandParameter="CROSS4"
                                    ToolTip.Tip="十자 4갈래. 전개도에서 중심→가지4 클릭." />
                        </StackPanel>
                        <TextBlock Text="{Binding CrossStepText}" Foreground="{DynamicResource AppAccentBrush}" FontSize="11" Margin="0,0,0,2"
                                   IsVisible="{Binding CrossStepText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <TextBlock Text="{Binding SeamRotationText, StringFormat='회전: {0}'}" Foreground="{DynamicResource AppGoodBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"
                                   IsVisible="{Binding SeamRotationText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Classes="form" Content="작업 등록" MinWidth="110" Command="{Binding RegisterTaskCommand}" />
                            <Button Classes="form" Content="선택 작업 수정" MinWidth="110" Margin="6,0,0,0" Command="{Binding UpdateTaskCommand}"
                                    ToolTip.Tip="작업 목록에서 선택한 용접선의 좌표·타입을 고칩니다. 삭제 후 재등록과 달리 taskId(검사 이력 키)가 유지됩니다." />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Classes="form" Content="코봇 이동 시험(시작점)" MinWidth="150" Command="{Binding TestSeamStartCommand}"
                                    ToolTip.Tip="선택 용접선의 정차점으로 AMR을 보낸 뒤 코봇을 seam 시작점까지만 이동시켜 reach를 확인합니다(촬영 없음). 실행은 HD_AMR. 진행 중 run이 없고 로봇이 해당 층에 있어야 합니다." />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource AppErrorBrush}" FontSize="12" />
            </StackPanel>
        </ScrollViewer>

        <!-- ── 우: 실시간 (u,v) 전개도 + 영역/작업 목록 ── -->
        <Grid Grid.Column="1" RowDefinitions="2*,Auto,Auto">
            <!-- 실시간 전개도 (좌측 폼 입력이 즉시 반영) -->
            <views:AreaLayoutView Grid.Row="0" Margin="0,0,0,8" />

            <DockPanel Grid.Row="1" MinHeight="130" Margin="0,0,0,8">
                <TextBlock DockPanel.Dock="Top" Text="선택 면 영역 목록 (선택 시 수정·작업 등록)" FontWeight="Bold" Margin="0,0,0,4" />
                <DataGrid x:Name="AreaGrid" ItemsSource="{Binding Areas}" SelectedItem="{Binding SelectedArea, Mode=TwoWay}"
                          AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="220">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="영역 이름" Binding="{Binding Name}" Width="Auto" MinWidth="100" />
                        <DataGridTextColumn Header="층" Binding="{Binding Level, StringFormat='L{0}'}" Width="Auto" MinWidth="44" />
                        <DataGridTextColumn Header="u 시작(m)" Binding="{Binding UMin, StringFormat='{}{0:N2}'}" Width="Auto" MinWidth="76" />
                        <DataGridTextColumn Header="u 끝(m)" Binding="{Binding UMax, StringFormat='{}{0:N2}'}" Width="Auto" MinWidth="76" />
                        <DataGridTextColumn Header="v 시작(m)" Binding="{Binding VMin, StringFormat='{}{0:N2}'}" Width="Auto" MinWidth="76" />
                        <DataGridTextColumn Header="v 끝(m)" Binding="{Binding VMax, StringFormat='{}{0:N2}'}" Width="Auto" MinWidth="76" />
                        <DataGridTextColumn Header="작업 수" Binding="{Binding TaskCount}" Width="Auto" MinWidth="64" />
                        <DataGridTemplateColumn Header="" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="삭제" Padding="8,1"
                                            Command="{Binding $parent[DataGrid].DataContext.DeleteAreaCommand}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <DockPanel Grid.Row="2" MinHeight="120">
                <TextBlock DockPanel.Dock="Top" Text="선택 영역 작업 목록 (선택 시 수정)" FontWeight="Bold" Margin="0,0,0,4" />
                <DataGrid x:Name="TaskGrid" ItemsSource="{Binding AreaTasks}" SelectedItem="{Binding SelectedTask, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="100" MaxHeight="220">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="순번" Binding="{Binding Seq}" Width="Auto" MinWidth="52" />
                        <DataGridTextColumn Header="유형" Binding="{Binding TypeLabel}" Width="Auto" MinWidth="72" />
                        <DataGridTextColumn Header="시작 u(m)" Binding="{Binding StartU, StringFormat='{}{0:N2}'}" Width="Auto" MinWidth="76" />
                        <DataGridTextColumn Header="시작 v(m)" Binding="{Binding StartV, StringFormat='{}{0:N2}'}" Width="Auto" MinWidth="76" />
                        <DataGridTextColumn Header="끝 u(m)" Binding="{Binding EndU, StringFormat='{}{0:N2}'}" Width="Auto" MinWidth="76" />
                        <DataGridTextColumn Header="끝 v(m)" Binding="{Binding EndV, StringFormat='{}{0:N2}'}" Width="Auto" MinWidth="76" />
                        <DataGridTemplateColumn Header="" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="삭제" Padding="8,1"
                                            Command="{Binding $parent[DataGrid].DataContext.DeleteTaskCommand}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>

        <!-- ── 우측: 계획 자연어 어시스턴트 [ADR-013] — 제안(미리보기) → [적용] ── -->
        <Border x:Name="AssistantPanel" Grid.Column="2" Margin="12,0,0,0" DataContext="{Binding Assistant}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="10">
            <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Text="계획 어시스턴트 (자연어)" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,6"
                           Foreground="{DynamicResource AppMutedTextBrush}" />
                <ScrollViewer Grid.Row="2" x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" Background="{DynamicResource AppCanvasBrush}">
                    <ItemsControl ItemsSource="{Binding Lines}" Margin="6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6" Padding="8,5" CornerRadius="4"
                                        Background="{Binding IsUser, Converter={StaticResource ChatBg}}">
                                    <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel Grid.Row="3" Margin="0,6,0,0" IsVisible="{Binding HasProposal}">
                    <TextBlock Text="{Binding ProposalSummary}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <ListBox ItemsSource="{Binding ProposalOps}" MaxHeight="160" FontSize="11">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Error}" IsVisible="{Binding !Ok}" TextWrapping="Wrap" Foreground="{DynamicResource AppErrorBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Classes="form" Content="적용" MinWidth="80" Command="{Binding ApplyCommand}"
                                ToolTip.Tip="변경안 전체를 한 번에 반영합니다(하나라도 실패하면 아무것도 반영하지 않음)." />
                        <Button Classes="form" Content="버리기" MinWidth="80" Margin="6,0,0,0" Command="{Binding DiscardCommand}" />
                    </StackPanel>
                </StackPanel>
                <TextBox Grid.Row="4" Margin="0,6,0,0" Text="{Binding Input}" AcceptsReturn="False" TextWrapping="Wrap" MinHeight="54"
                         Watermark="예: PM 2층 작업 전부 CROSS4로 바꿔">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding SendCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
                <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Classes="form" Content="보내기" MinWidth="80" Command="{Binding SendCommand}" />
                    <Button Classes="form" Content="연결 확인" MinWidth="80" Margin="6,0,0,0" Command="{Binding CheckStatusCommand}" />
                    <TextBlock Text="처리 중…" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
