<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HD.Acs.UI.Desktop.Views.NewProjectDialog"
        Title="새 프로젝트 — 도면(DXF)에서 선창 생성" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" CanResize="False" ShowInTaskbar="False"
        Background="{DynamicResource AppWindowBrush}"
        TextBlock.Foreground="{DynamicResource AppTextBrush}">
    <!-- DataContext = AreaPlanningViewModel(공유 싱글턴). 확인 시 선창 등록 성공하면 Close(true). -->
    <StackPanel Margin="18">
        <TextBlock Text="① 면별 CAD(DXF) 등록 — 도면에서 형상 추출" FontWeight="Bold" FontSize="14" Margin="0,0,0,4" />
        <TextBlock Foreground="{DynamicResource AppMutedTextBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="파라미터 수기 입력 없이 도면(DXF)만으로 선창을 만듭니다. 마구리(A 또는 F) 면에서 팔각 단면을, 측벽/바닥/천장 면 폭에서 길이를 추출해 10면을 생성하고, 각 면의 용접선·Corrugation을 전개도 면 뷰에 표시합니다. 필수: 마구리(A/F) 1장 + 측벽/천장/바닥 1장 이상." />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="Tank" Classes="lbl" />
            <TextBox Width="110" Classes="field" Text="{Binding TankId}" />
        </StackPanel>

        <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,0,4">
            <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding CadFaces}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="42,*,Auto,Auto" Margin="0,2">
                                <TextBlock Grid.Column="0" Text="{Binding WallCode}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Status}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AppMutedTextBrush}" FontSize="11.5" Margin="0,0,8,0" />
                                <Button Grid.Column="2" Content="파일…" Tag="{Binding WallCode}" Click="PickDxf_Click" Margin="0,0,4,0" MinWidth="56" />
                                <Button Grid.Column="3" Content="해제" Tag="{Binding WallCode}" Click="ClearDxf_Click" MinWidth="46"
                                        IsEnabled="{Binding Registered}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <TextBlock Text="{Binding DerivedText}" TextWrapping="Wrap" Margin="0,2,0,6" FontSize="12" />

        <TextBlock Text="② 운영 파라미터 (도면에 없는 값)" FontWeight="Bold" FontSize="13" Margin="0,4,0,4" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="level_z" Classes="lbl" ToolTip.Tip="AMR 주행 층 경계 z 목록(도면에 없는 운영값). 쉼표 구분 (예: 0, 3.2, 6.4, 9.6)" />
            <TextBox Width="200" Classes="field" Text="{Binding LevelZText}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="reach_z min,max" Classes="lbl"
                       ToolTip.Tip="(선택) 플랫폼 기준 코봇 도달 밴드 상대높이. 비우면 밴드=층 경계 그대로." />
            <TextBox Width="97" Classes="field" Text="{Binding ReachZMinText}" Margin="0,0,6,0" />
            <TextBox Width="97" Classes="field" Text="{Binding ReachZMaxText}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="원점보정 ox,oy" Classes="lbl" />
            <NumericUpDown Classes="field" MinWidth="120" Value="{Binding OriginOx}" Margin="0,0,6,0" />
            <NumericUpDown Classes="field" MinWidth="120" Value="{Binding OriginOy}" />
        </StackPanel>
        <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,0,4">
            <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding CadFaces}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="42,*,Auto,Auto" Margin="0,2">
                                <TextBlock Grid.Column="0" Text="{Binding WallCode}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Status}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AppMutedTextBrush}" FontSize="11.5" Margin="0,0,8,0" />
                                <Button Grid.Column="2" Content="파일…" Tag="{Binding WallCode}" Click="PickDxf_Click" Margin="0,0,4,0" MinWidth="56" />
                                <Button Grid.Column="3" Content="해제" Tag="{Binding WallCode}" Click="ClearDxf_Click" MinWidth="46"
                                        IsEnabled="{Binding Registered}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,0,0,4" FontSize="11.5"
                   Foreground="{DynamicResource AppAccentBrush}" />

        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Margin="0,0,0,4" Foreground="{DynamicResource AppErrorBrush}" FontSize="12" IsVisible="False" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="OkButton" Content="확인 · 선창 생성" MinWidth="130" MinHeight="32" Margin="0,0,8,0" Click="Ok_Click" />
            <Button Content="취소" MinWidth="80" MinHeight="32" Click="Cancel_Click" />
        </StackPanel>
    </StackPanel>
</Window>
