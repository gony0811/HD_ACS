<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HD.Acs.UI.Desktop.Views.CalibrationView">
    <!-- DataContext = CalibrationViewModel -->
    <Grid Margin="10" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" TextBlock.Foreground="{DynamicResource AppTextBrush}">
        <StackPanel Grid.Row="0" Margin="0,0,0,6">
            <TextBlock Text="도면→맵 캘리브레이션 (T_W_D) · Operator" FontWeight="Bold" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource AppMutedTextBrush}"
                       Text="로봇을 도면상 알려진 기준점으로 이동시킨 뒤, 그 점의 도면 좌표를 입력하고 '현재 위치 캡처'를 누르세요. 2~3점 캡처 후 '계산'." />
        </StackPanel>

        <!-- 층 선택 + 로봇 보고 준비 상태 -->
        <Grid Grid.Row="1" Margin="0,0,0,6" ColumnDefinitions="Auto,*">
            <TextBlock Text="층" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Floors}"
                      DisplayMemberBinding="{Binding Level}"
                      SelectedItem="{Binding SelectedFloor}" />
        </Grid>
        <Border Grid.Row="2" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="6" Margin="0,0,0,8">
            <TextBlock Text="{Binding ReadinessText}" TextWrapping="Wrap" />
        </Border>

        <!-- 도면 좌표 입력 + 캡처 -->
        <Grid Grid.Row="3" Margin="0,0,0,8" ColumnDefinitions="*,*,Auto,Auto">
            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                <TextBlock Text="도면 X" />
                <NumericUpDown Value="{Binding DrawingX}" FormatString="0.###" Increment="0.1" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="2,0">
                <TextBlock Text="도면 Y" />
                <NumericUpDown Value="{Binding DrawingY}" FormatString="0.###" Increment="0.1" />
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="4,0" VerticalAlignment="Bottom">
                <TextBlock Text="단위" />
                <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding Unit}" Width="70" />
            </StackPanel>
            <Button Grid.Column="3" Content="현재 위치 캡처" VerticalAlignment="Bottom"
                    Margin="6,0,0,0" Command="{Binding CapturePointCommand}" />
        </Grid>

        <!-- 대응쌍 목록 -->
        <DataGrid Grid.Row="4" x:Name="PointGrid" ItemsSource="{Binding Points}"
                  AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="도면X" Binding="{Binding DrawingXM, StringFormat='{}{0:N3}'}" Width="70" />
                <DataGridTextColumn Header="도면Y" Binding="{Binding DrawingYM, StringFormat='{}{0:N3}'}" Width="70" />
                <DataGridTextColumn Header="맵X" Binding="{Binding MapX, StringFormat='{}{0:N3}'}" Width="70" />
                <DataGridTextColumn Header="맵Y" Binding="{Binding MapY, StringFormat='{}{0:N3}'}" Width="70" />
                <DataGridTemplateColumn Header="" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="삭제" Padding="6,1"
                                    Command="{Binding $parent[DataGrid].DataContext.DeletePointCommand}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 결과 + 경고 배지 -->
        <StackPanel Grid.Row="5" Margin="0,6,0,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Button Content="계산 (solve)" Command="{Binding SolveCommand}" Margin="0,0,6,0" />
                <Button Content="새로고침" Command="{Binding RefreshCommand}" />
            </StackPanel>
            <Border Background="{DynamicResource AppInfoBgBrush}" BorderBrush="{DynamicResource AppInfoBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="6">
                <TextBlock Text="{Binding CalibrationSummary}" TextWrapping="Wrap" Foreground="{DynamicResource AppInfoFgBrush}" />
            </Border>
            <Border Background="{DynamicResource AppWarnBgBrush}" BorderBrush="{DynamicResource AppWarnBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="6"
                    Margin="0,6,0,0" IsVisible="{Binding HasWarning}">
                <TextBlock Text="{Binding WarningText}" TextWrapping="Wrap" Foreground="{DynamicResource AppWarnFgBrush}" />
            </Border>
        </StackPanel>

        <TextBlock Grid.Row="6" Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{DynamicResource AppMutedTextBrush}" Margin="0,8,0,0" />
    </Grid>
</UserControl>
