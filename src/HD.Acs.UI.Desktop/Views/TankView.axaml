<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:HD.Acs.UI.Desktop.Views"
             x:Class="HD.Acs.UI.Desktop.Views.TankView">
    <!-- DataContext = TankViewModel. 3D 뷰=소프트웨어 투영 렌더러(Tank3DControl), 전개도 탭=면별 2D 캔버스. -->
    <DockPanel TextBlock.Foreground="{DynamicResource AppTextBrush}">
        <!-- 뷰 모드(전체/L1~L4) + 오버레이·수동 이동 토글 + 로봇 위치 -->
        <Border DockPanel.Dock="Top" Padding="8" Background="{DynamicResource AppHeaderBrush}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="뷰" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Width="90" ItemsSource="{Binding ViewModes}" SelectedItem="{Binding SelectedViewMode}" />
                <CheckBox Content="영역·작업 표시" VerticalAlignment="Center" Margin="16,0,0,0"
                          IsChecked="{Binding ShowOverlays}" />
                <CheckBox Content="수동 이동" VerticalAlignment="Center" Margin="16,0,0,0"
                           IsEnabled="{Binding IsolateLevel}"
                          ToolTip.Tip="바닥의 정차 위치에서 원하는 방향으로 드래그하세요. 짧게 클릭하면 방향 자유로 이동합니다."
                          IsChecked="{Binding ManualMoveMode}" />
                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource AppMutedTextBrush}"
                           Text="{Binding MoveStatus}" />
                <TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
                           Text="{Binding RobotMapId, StringFormat='로봇 층: {0}'}" />
                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center"
                           Text="{Binding RobotX, StringFormat='X: {0:F2}', FallbackValue='X: -'}" />
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                           Text="{Binding RobotY, StringFormat='Y: {0:F2}', FallbackValue='Y: -'}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Padding="8" IsVisible="{Binding ManualMoveMode}" IsEnabled="{Binding IsolateLevel}">
            <WrapPanel>
                <TextBlock Text="도면 X (m)" VerticalAlignment="Center" Margin="0,0,6,0" />
                <NumericUpDown Width="120" Value="{Binding ManualDrawingX}" FormatString="0.00" Increment="0.01" Margin="0,0,12,0" />
                <TextBlock Text="도면 Y (m)" VerticalAlignment="Center" Margin="0,0,6,0" />
                <NumericUpDown Width="120" Value="{Binding ManualDrawingY}" FormatString="0.00" Increment="0.01" Margin="0,0,12,0" />
                <TextBlock Text="방향 (°)" VerticalAlignment="Center" Margin="0,0,6,0" />
                <NumericUpDown Width="100" Value="{Binding ManualHeadingDegrees}" FormatString="0.0" Increment="1" ToolTip.Tip="도면 기준 각도. 비워두면 방향 자유." Margin="0,0,12,0" />
                <Button Content="입력 좌표로 이동" Command="{Binding MoveToCoordinatesCommand}" />
            </WrapPanel>
        </Border>

        <TabControl x:Name="TankTabs">
            <TabItem Header="3D 뷰">
                <!-- 소프트웨어 투영 렌더러 — 좌드래그 오빗 · 우/중드래그 팬 · 휠 줌 · 수동 이동 모드 위치→방향 드래그=goto -->
                <Grid>
                    <views:Tank3DControl x:Name="Tank3D">
                        <views:Tank3DControl.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="3D 뷰 표시 항목" IsEnabled="False" />
                                <Separator />
                                <MenuItem Header="영역 (채움·윤곽)" ToggleType="CheckBox" StaysOpenOnClick="True" IsChecked="{Binding View3DLayers.AreaFills, Mode=TwoWay}" />
                                <MenuItem Header="영역 이름" ToggleType="CheckBox" StaysOpenOnClick="True" IsChecked="{Binding View3DLayers.AreaLabels, Mode=TwoWay}" />
                                <MenuItem Header="용접선" ToggleType="CheckBox" StaysOpenOnClick="True" IsChecked="{Binding View3DLayers.WeldLines, Mode=TwoWay}" />
                                <MenuItem Header="용접 시작·끝점" ToggleType="CheckBox" StaysOpenOnClick="True" IsChecked="{Binding View3DLayers.WeldEndpoints, Mode=TwoWay}" />
                                <MenuItem Header="작업 순번" ToggleType="CheckBox" StaysOpenOnClick="True" IsChecked="{Binding View3DLayers.TaskSeq, Mode=TwoWay}" />
                                <Separator />
                                <MenuItem Header="바닥 격자 (1m, 층 뷰)" ToggleType="CheckBox" StaysOpenOnClick="True" IsChecked="{Binding View3DLayers.FloorGrid, Mode=TwoWay}" />
                                <MenuItem Header="지면 참조 격자" ToggleType="CheckBox" StaysOpenOnClick="True" IsChecked="{Binding View3DLayers.GroundGrid, Mode=TwoWay}" />
                                <Separator />
                                <MenuItem Header="모두 표시" Command="{Binding View3DLayers.ShowAllCommand}" />
                                <MenuItem Header="빠른 보기 (윤곽·용접선만)" Command="{Binding View3DLayers.ShowMinimalCommand}" />
                            </ContextMenu>
                        </views:Tank3DControl.ContextMenu>
                    </views:Tank3DControl>
                    <Button Content="맞춤" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="8,2" FontSize="11"
                            Opacity="0.85" Click="ZoomExtents_Click" ToolTip.Tip="전체 형상에 맞춤" />
                    <TextBlock HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,4" FontSize="10.5"
                               Foreground="{DynamicResource AppMutedTextBrush}"
                               Text="좌드래그 회전 · 우드래그 이동 · 휠 확대/축소 · 우클릭 표시 항목" />
                </Grid>
            </TabItem>

            <TabItem Header="전개도">
                <!-- 면별 2D 도면 그리드 — 각 면 실제 비율 형상(마구리 F/A=팔각) + 영역·작업 오버레이. 우클릭=표시 항목 -->
                <ScrollViewer x:Name="FlatScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource AppWindowBrush}">
                    <ScrollViewer.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="전개도 표시 항목" IsEnabled="False" />
                            <Separator />
                            <MenuItem Header="영역 (채움·윤곽)" ToggleType="CheckBox" StaysOpenOnClick="True" IsChecked="{Binding FlatLayers.AreaFills, Mode=TwoWay}" />
                            <MenuItem Header="영역 이름" ToggleType="CheckBox" StaysOpenOnClick="True" IsChecked="{Binding FlatLayers.AreaLabels, Mode=TwoWay}" />
                            <MenuItem Header="용접선" ToggleType="CheckBox" StaysOpenOnClick="True" IsChecked="{Binding FlatLayers.WeldLines, Mode=TwoWay}" />
                            <MenuItem Header="용접 시작·끝점" ToggleType="CheckBox" StaysOpenOnClick="True" IsChecked="{Binding FlatLayers.WeldEndpoints, Mode=TwoWay}" />
                            <MenuItem Header="작업 순번" ToggleType="CheckBox" StaysOpenOnClick="True" IsChecked="{Binding FlatLayers.TaskSeq, Mode=TwoWay}" />
                            <Separator />
                            <MenuItem Header="모두 표시" Command="{Binding FlatLayers.ShowAllCommand}" />
                            <MenuItem Header="빠른 보기 (윤곽·용접선만)" Command="{Binding FlatLayers.ShowMinimalCommand}" />
                        </ContextMenu>
                    </ScrollViewer.ContextMenu>
                    <ItemsControl x:Name="FacePlotList" ItemsSource="{Binding FacePlots}" Margin="8">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="6" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        Click="FaceCell_Click" ToolTip.Tip="클릭하여 이 면에 용접선·Corrugation 드로잉 도구 열기">
                                <Border Padding="6" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="3" Background="{DynamicResource AppSurfaceBrush}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Code}" FontWeight="Bold" FontSize="13" />
                                            <TextBlock Text="✎" FontSize="12" Margin="6,0,0,0" Foreground="{DynamicResource AppMutedTextBrush}" />
                                            <TextBlock Text="{Binding Dim}" FontSize="11" Foreground="{DynamicResource AppMutedTextBrush}" Margin="8,2,0,0" />
                                        </StackPanel>
                                        <!-- 면 형상 + 영역·용접선을 컨트롤 1개가 직접 그림(항목마다 컨트롤을 만들지 않음) — 표시 항목은 우클릭 메뉴 -->
                                        <views:FacePlotCanvas Width="240" Height="150" />
                                    </StackPanel>
                                </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
