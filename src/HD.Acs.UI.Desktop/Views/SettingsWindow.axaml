<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HD.Acs.UI.Desktop.Views.SettingsWindow"
        Title="설정 — 로봇 정보" Width="520" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppWindowBrush}"
        TextBlock.Foreground="{DynamicResource AppTextBrush}">
    <!-- DataContext = SettingsViewModel(공유 싱글턴). 로봇 타입 기본 정보 선택·기입·저장. -->
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="로봇 정보" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />

        <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Classes="form" Content="새 로봇" Command="{Binding NewRobotCommand}" />
                <Button Classes="form" Content="저장" Command="{Binding SaveCommand}" />
                <Button Content="닫기" MinWidth="80" Click="Close_Click" />
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource AppMutedTextBrush}" />
        </StackPanel>

        <Grid ColumnDefinitions="*,16,240">
            <!-- 좌: 로봇 선택 목록 -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="로봇 선택" FontSize="12"
                           Foreground="{DynamicResource AppMutedTextBrush}" Margin="0,0,0,4" />
                <ListBox ItemsSource="{Binding Robots}" SelectedItem="{Binding SelectedRobot}"
                         Background="{DynamicResource AppWindowBrush}"
                         BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding RobotId}" FontSize="11"
                                           Foreground="{DynamicResource AppMutedTextBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- 우: 기본 정보 기입 -->
            <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Text="기본 정보" FontSize="12"
                           Foreground="{DynamicResource AppMutedTextBrush}" Margin="0,0,0,4" />
                <TextBlock Text="로봇 ID" />
                <TextBox Text="{Binding RobotId}" />
                <TextBlock Text="이름(로봇 타입)" Margin="0,4,0,0" />
                <TextBox Text="{Binding Name}" />
                <TextBlock Text="제조사(Manufacturer)" Margin="0,4,0,0" />
                <TextBox Text="{Binding Manufacturer}" />
                <TextBlock Text="시리얼(SerialNumber)" Margin="0,4,0,0" />
                <TextBox Text="{Binding SerialNumber}" />
                <TextBlock Text="VDA 버전" Margin="0,4,0,0" />
                <TextBox Text="{Binding VdaVersion}" />
                <CheckBox Content="활성(IsActive)" IsChecked="{Binding IsActive}" Margin="0,8,0,0" />
                <TextBlock Text="※ 제조사·시리얼은 VDA5050 MQTT 토픽 요소입니다. 변경 시 로봇 재구독(재기동)이 필요합니다."
                           FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                           Foreground="{DynamicResource AppMutedTextBrush}" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
