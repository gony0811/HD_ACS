<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HD.Acs.UI.Desktop.Views.HistoryView"
             TextBlock.Foreground="{DynamicResource AppTextBrush}">
    <Grid DataContext="{Binding History}" Margin="12" RowDefinitions="Auto,2*,Auto,3*">
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="새로고침" Command="{Binding LoadCommand}" Padding="14,6" />
            <StackPanel>
                <TextBlock Text="검사 실행 이력" FontSize="18" FontWeight="Bold" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource AppMutedTextBrush}" />
            </StackPanel>
        </DockPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun}"
                  AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="시작 시각" Binding="{Binding StartedAt}" Width="165" />
                <DataGridTextColumn Header="시나리오" Binding="{Binding ScenarioName}" Width="150" />
                <DataGridTextColumn Header="로봇" Binding="{Binding RobotId}" Width="90" />
                <DataGridTextColumn Header="RUN 상태" Binding="{Binding State}" Width="90" />
                <DataGridTextColumn Header="결과" Binding="{Binding Outcome}" Width="70" />
                <DataGridTextColumn Header="성공" Binding="{Binding Success}" Width="55" />
                <DataGridTextColumn Header="실패" Binding="{Binding Failed}" Width="55" />
                <DataGridTextColumn Header="실패 원인" Binding="{Binding FailureReason}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" Margin="0,12,0,6" Text="선택한 RUN의 작업 결과" FontSize="15" FontWeight="Bold" />
        <DataGrid Grid.Row="3" ItemsSource="{Binding Results}" AutoGenerateColumns="False"
                  IsReadOnly="True" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="발생 시각" Binding="{Binding OccurredAt}" Width="165" />
                <DataGridTextColumn Header="AREA" Binding="{Binding AreaName}" Width="130" />
                <DataGridTextColumn Header="면" Binding="{Binding WallCode}" Width="50" />
                <DataGridTextColumn Header="층" Binding="{Binding Level}" Width="45" />
                <DataGridTextColumn Header="결과" Binding="{Binding Status}" Width="80" />
                <DataGridTextColumn Header="시도" Binding="{Binding Attempts}" Width="55" />
                <DataGridTextColumn Header="성공/실패 상세" Binding="{Binding Description}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
