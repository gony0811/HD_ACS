<?xml version="1.0" encoding="utf-8"?>
<!--
  HD_ACS NuGet 소스 설정.
  공개 피드(nuget.org) 하나만 쓴다 — 상용 Telerik UI for WPF 피드는 WPF 헤드(HD.Acs.UI)
  은퇴와 함께 제거했다(이행 Phase 5). 자격증명이 없는 환경에서 그 피드가 복원 경고를
  내던 문제도 함께 해소된다. UI 헤드는 Avalonia(HD.Acs.UI.Desktop) 하나뿐이며
  의존성은 전부 nuget.org 공개 패키지다.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
