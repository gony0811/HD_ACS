<?xml version="1.0" encoding="utf-8"?>
<!--
  HD_ACS NuGet 소스 설정.
  Telerik UI for WPF는 상용 제품으로 전용 피드(nuget.telerik.com)에서 복원한다.
  ※ 자격증명은 이 파일에 커밋하지 말 것. 아래 중 하나로 별도 주입:
     1) dotnet nuget add source (Telerik 피드, 사용자/토큰 지정, clear-text 저장 옵션)
     2) 또는 유저 레벨 %AppData%\NuGet\NuGet.Config 의 packageSourceCredentials
     3) CI: 환경변수 기반 credential provider
-->
<configuration>
  <!--
    packageSourceMapping은 두지 않는다.
    Telerik 의존성이 두 피드에 나뉘어 있어(Telerik.Licensing=nuget.org 공개, MediaFoundation=Telerik 피드 전용)
    Telerik.* 매핑이 오히려 복원을 깨뜨린다. 매핑 없이 NuGet이 각 패키지를 버전이 존재하는 소스에서 해석한다.
    (Telerik 메인 패키지는 nuget.org에 없고 버전이 핀되어 있어 공개 패키지 섀도잉 위험 없음.)
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="Telerik" value="https://nuget.telerik.com/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
